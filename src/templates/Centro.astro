---
// Ficha de centro. Solo datos con fuente pública: nada de teléfonos, correos,
// nombres de personas, precios ni valoraciones. Si solo hay nombre, municipio
// y disciplina, la ficha existe (para quien busca el nombre) pero en noindex.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Migas from '../components/Migas.astro';
import CentroCard from '../components/CentroCard.astro';
import Formulario from '../components/Formulario.astro';
import GuiasRelacionadas from '../components/GuiasRelacionadas.astro';
import { L, url, lista, titulo, descripcion, fecha, type Lang, minus } from '../lib/i18n';
import { getCentro, centrosDeMunicipio, cercanos, esPromocionado, esVerificado } from '../lib/centros';
import { getComarca, getMunicipio } from '../lib/geo';
import { nombreDisciplina } from '../lib/disciplinas';
import { tienePaginaMunicipio, tienePaginaMunDisc, fichaIndexable } from '../lib/rutas';
import { SITE, SCHEMA_IDS } from '../lib/site';
import { getDisciplineBySlug, PERFIL_COMPARATIVO } from '../lib/guias-disciplina';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const c = getCentro(slug)!;
const mun = getMunicipio(c.municipio)!;
const com = getComarca(c.comarca)!;
const promo = esPromocionado(c.slug);
const discs = c.disciplinas.map(d => nombreDisciplina(d, lang));
// Algunas fuentes solo dicen "artes marciales": la ficha no inventa la disciplina.
const actividad = discs.length ? lista(lang, discs.map(minus)) : L(lang, 'artes marciales', 'arts marcials');
const vecinos = centrosDeMunicipio(c.municipio).filter(x => x.slug !== c.slug)
  .sort((a, b) => Number(esVerificado(b)) - Number(esVerificado(a))).slice(0, 6);
const parecidos = vecinos.length < 3
  ? cercanos(mun, x => x.slug !== c.slug && x.disciplinas.some(d => c.disciplinas.includes(d)), 6 - vecinos.length, 30)
  : [];

// "Qué esperar" de la primera disciplina con guía: genérico, solo en castellano.
const dGuia = lang === 'es' ? c.disciplinas.find(d => getDisciplineBySlug(d) && PERFIL_COMPARATIVO[d]) : undefined;
const guia = dGuia ? getDisciplineBySlug(dGuia) : undefined;
const perfil = dGuia ? PERFIL_COMPARATIVO[dGuia] : undefined;
const verif = esVerificado(c);
const iniciales = c.nombre.replace(/^(club|escola|escuela|associació|asociación|gimnàs|gimnasio|centre|centro|academia|acadèmia)\s+(d'|de\s+|del\s+)?/i, '')
  .split(/[\s-]+/).filter(w => /^[\p{L}\d]/u.test(w) && !/^(de|del|la|el|i|y|d'.*)$/i.test(w)).slice(0, 2).map(w => w[0].toUpperCase()).join('') || c.nombre[0];
const sello = `<a href="${SITE.url}${url.centro(lang, c.slug)}" title="${L(lang, 'Ficha verificada en Artes Marciales Catalunya', 'Fitxa verificada a Arts Marcials Catalunya')}"><img src="${SITE.url}/sello/ficha-verificada-${lang}.svg" alt="${L(lang, 'Ficha verificada en Artes Marciales Catalunya', 'Fitxa verificada a Arts Marcials Catalunya')}" width="220" height="56"></a>`;
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([c.nombre, c.direccion, mun.nombre].filter(Boolean).join(', '))}`;
const webCorta = c.web?.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const FUENTE: Record<string, [string, string]> = {
  'web-oficial': ['Web oficial del centro', 'Web oficial del centre'],
  'federacion': ['Registro de clubs de la federación', 'Registre de clubs de la federació'],
  'directorio-municipal': ['Directorio municipal de entidades', "Directori municipal d'entitats"],
  'registro-oficial': ["Registre d'Entitats Esportives de la Generalitat", "Registre d'Entitats Esportives de la Generalitat"],
  'perfil-publico': ['Perfil público del centro', 'Perfil públic del centre'],
};
const TIPO: Record<string, [string, string]> = {
  escuela: ['Escuela', 'Escola'], club: ['Club', 'Club'], asociacion: ['Asociación', 'Associació'], gimnasio: ['Gimnasio', 'Gimnàs'],
};
const fuenteLabel = L(lang, ...FUENTE[c.fuenteTipo]);
// El registro se enlaza en su página pública de datos abiertos, no en la API (que devuelve JSON).
const nRegistro = c.fuenteTipo === 'registro-oficial' ? new URL(c.fuente).searchParams.get('n_m_registre') : null;
const fuenteHref = nRegistro ? 'https://analisi.transparenciacatalunya.cat/d/qrgc-u7pk' : c.fuente;
const lead = c.fuenteTipo === 'registro-oficial'
  ? L(lang,
      `Consta en el registro oficial de entidades deportivas como ${TIPO_TXT()} en ${mun.nombre}. No hemos podido confirmar que siga dando clases: pregunta antes de ir.`,
      `Consta al registre oficial d'entitats esportives com a ${TIPO_TXT()} a ${mun.nombre}. No hem pogut confirmar que continuï fent classes: pregunta abans d'anar-hi.`)
  : L(lang,
      `${TIPO_TXT(true)} en ${mun.nombre} (${com.nombre}).${c.infantil ? ' Su fuente anuncia clases para niños.' : ''}`,
      `${TIPO_TXT(true)} a ${mun.nombre} (${com.nombre}).${c.infantil ? ' La seva font anuncia classes per a infants.' : ''}`);
function TIPO_TXT(mayus = false) {
  const t = L(lang, ...TIPO[c.tipo]);
  const txt = `${mayus ? t : t.toLowerCase()} de ${actividad}`;
  return txt;
}


const title = titulo(
  L(lang, `${c.nombre} · ${mun.nombre} | ${discs.length ? lista(lang, discs.slice(0, 2)) : L(lang, 'Artes marciales', 'Arts marcials')}`, `${c.nombre} · ${mun.nombre}`),
  `${c.nombre} · ${mun.nombre}`,
  c.nombre,
);
const description = descripcion(
  L(lang,
    `${c.nombre}, ${TIPO[c.tipo][0].toLowerCase()} de ${actividad} en ${mun.nombre} (${com.nombre}). Datos verificados con su fuente pública${c.web ? ' y enlace a su web' : ''}.`,
    `${c.nombre}, ${TIPO[c.tipo][1].toLowerCase()} de ${actividad} a ${mun.nombre} (${com.nombre}). Dades verificades amb la seva font pública${c.web ? ' i enllaç al seu web' : ''}.`),
);

const alternates = { es: url.centro('es', c.slug), ca: url.centro('ca', c.slug) };
const pageUrl = `${SITE.url}${url.centro(lang, c.slug)}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SportsActivityLocation',
    '@id': `${pageUrl}#centro`,
    name: c.nombre,
    ...(c.web ? { url: c.web, sameAs: [c.web] } : {}),
    ...(c.direccion
      ? { address: { '@type': 'PostalAddress', streetAddress: c.direccion, addressLocality: mun.nombre, addressRegion: 'Catalunya', addressCountry: 'ES' } }
      : { address: { '@type': 'PostalAddress', addressLocality: mun.nombre, addressRegion: 'Catalunya', addressCountry: 'ES' } }),
    knowsAbout: c.disciplinas.map(d => nombreDisciplina(d, 'es')),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': pageUrl,
    name: title,
    url: pageUrl,
    inLanguage: lang,
    isPartOf: { '@id': SCHEMA_IDS.website },
    publisher: { '@id': SCHEMA_IDS.organization },
    about: { '@id': `${pageUrl}#centro` },
    dateModified: c.verificado,
  },
];
---

<Layout ogImage={`${SITE.url}/og/c/${c.comarca}-${lang}.jpg`} title={title} description={description} canonical={url.centro(lang, c.slug)} schema={schema} lang={lang} alternates={alternates} noindex={!fichaIndexable(c)}>
  <Header lang={lang} alt={alternates[lang === 'es' ? 'ca' : 'es']} />
  <main id="contenido" class="pb-24 lg:pb-0">
    <Migas lang={lang} items={[
      { nombre: com.nombre, href: url.comarca(lang, c.comarca) },
      ...(tienePaginaMunicipio(c.municipio) ? [{ nombre: mun.nombre, href: url.municipio(lang, c.comarca, c.municipio) }] : []),
      { nombre: c.nombre, href: url.centro(lang, c.slug) },
    ]} />

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 grid lg:grid-cols-[minmax(0,1fr)_360px] gap-6 lg:gap-8 items-start">
      <div class="space-y-6 min-w-0">
        <header class="relative overflow-hidden bg-linear-to-br from-brand-gray via-brand-gray to-brand-dark border border-brand-border rounded-2xl p-6 sm:p-8">
          <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 w-64 h-64 rounded-full bg-brand-red/10 blur-3xl"></div>
          <div class="relative flex items-start gap-4">
            <div aria-hidden="true" class="shrink-0 w-14 h-14 sm:w-16 sm:h-16 rounded-xl bg-brand-red/10 border border-brand-red/30 grid place-items-center text-brand-redtext text-lg sm:text-xl font-black tracking-tight">{iniciales}</div>
            <div class="min-w-0">
              <p class="text-xs uppercase tracking-wide text-brand-muted font-semibold">{L(lang, ...TIPO[c.tipo])} · {mun.nombre} · {com.nombre}</p>
              <h1 class="text-2xl sm:text-4xl font-black text-white leading-tight mt-1 wrap-break-word">{c.nombre}</h1>
            </div>
          </div>

          <ul class="relative flex flex-wrap gap-2 mt-5 text-xs font-medium">
            {verif
              ? <li class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 px-2.5 py-1"><svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>{L(lang, 'Actividad verificada', 'Activitat verificada')}</li>
              : <li class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 px-2.5 py-1">{L(lang, 'Sin verificar', 'Sense verificar')}</li>}
            {c.infantil && <li class="rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-300 px-2.5 py-1">{L(lang, 'Clases para niños', 'Classes per a infants')}</li>}
            {c.web && <li class="rounded-full bg-white/5 border border-brand-border text-white/80 px-2.5 py-1">{L(lang, 'Web oficial', 'Web oficial')}</li>}
            {promo && <li class="rounded-full bg-amber-500/10 border border-amber-500/40 text-amber-400 px-2.5 py-1" title={L(lang, 'Este centro paga por aparecer destacado', 'Aquest centre paga per aparèixer destacat')}>{L(lang, 'Promocionado', 'Promocionat')}</li>}
          </ul>

          <p class="relative text-base sm:text-lg text-brand-muted mt-4 leading-relaxed">{lead}</p>

          <div class="relative flex flex-wrap gap-3 mt-6">
            {c.web && (
              <a href={c.web} target="_blank" rel={promo ? 'sponsored noopener' : 'noopener'} class="hidden lg:inline-flex items-center gap-2 bg-brand-red hover:bg-red-700 text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors" data-evento="clic_web_centro" data-centro={c.slug}>
                {L(lang, 'Visitar su web', 'Visitar el seu web')} <span aria-hidden="true">↗</span>
              </a>
            )}
            <a href="#pedir-info" class:list={['hidden lg:inline-flex items-center gap-2 text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors', c.web ? 'bg-white/5 hover:bg-white/10 border border-brand-border text-white' : 'bg-brand-red hover:bg-red-700 text-white']} data-evento="abrir_pedir_info" data-centro={c.slug}>
              {L(lang, 'Pedir información', 'Demanar informació')}
            </a>
            <a href={mapa} target="_blank" rel="noopener nofollow" class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-brand-border text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors" data-evento="clic_mapa" data-centro={c.slug}>
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18s6-5.3 6-10A6 6 0 004 8c0 4.7 6 10 6 10zm0-7.5A2.5 2.5 0 1010 5.5a2.5 2.5 0 000 5z" clip-rule="evenodd"/></svg>
              {L(lang, 'Cómo llegar', 'Com arribar-hi')}
            </a>
          </div>
        </header>

        <section class="grid sm:grid-cols-2 gap-4">
          <div class="bg-brand-gray border border-brand-border rounded-xl p-5">
            <h2 class="text-xs uppercase tracking-wide text-brand-muted font-semibold mb-3">{L(lang, 'Qué se entrena', "Què s'hi entrena")}</h2>
            {c.disciplinas.length > 0
              ? <ul class="flex flex-wrap gap-2">
                  {c.disciplinas.map(d => (
                    <li><a href={tienePaginaMunDisc(c.municipio, d) ? url.munDisc(lang, c.comarca, c.municipio, d) : url.disciplina(lang, d)} class="inline-block bg-brand-dark border border-brand-border rounded-full px-3 py-1 text-sm text-white hover:border-brand-red/50 transition-colors">{nombreDisciplina(d, lang)}</a></li>
                  ))}
                </ul>
              : <p class="text-sm text-white">{L(lang, 'Artes marciales (la fuente no detalla cuáles)', 'Arts marcials (la font no detalla quines)')}</p>}
            {c.otras && c.otras.length > 0 && <p class="text-sm text-brand-muted mt-3">{L(lang, 'También anuncia', 'També anuncia')}: <span class="text-white/90">{c.otras.join(' · ')}</span></p>}
          </div>
          <div class="bg-brand-gray border border-brand-border rounded-xl p-5">
            <h2 class="text-xs uppercase tracking-wide text-brand-muted font-semibold mb-3">{L(lang, 'Dónde', 'On')}</h2>
            <p class="text-sm text-white leading-relaxed">{c.direccion ?? L(lang, 'Dirección no publicada en su fuente', 'Adreça no publicada a la seva font')}</p>
            <p class="text-sm text-brand-muted mt-1">
              {tienePaginaMunicipio(c.municipio) ? <a href={url.municipio(lang, c.comarca, c.municipio)} class="hover:text-white underline underline-offset-2">{mun.nombre}</a> : mun.nombre}
              {' · '}<a href={url.comarca(lang, c.comarca)} class="hover:text-white underline underline-offset-2">{com.nombre}</a>
            </p>
            <a href={mapa} target="_blank" rel="noopener nofollow" class="inline-block text-sm text-brand-redtext hover:text-red-400 mt-3" data-evento="clic_mapa" data-centro={c.slug}>{L(lang, 'Ver en el mapa', 'Veure al mapa')} ↗</a>
          </div>
        </section>

        {guia && perfil && dGuia && (
          <section class="bg-brand-gray border border-brand-border rounded-xl p-5 sm:p-6">
            <h2 class="text-lg font-bold text-white">Si es tu primera clase de {minus(nombreDisciplina(dGuia, 'es'))}</h2>
            <dl class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4">
              <div class="bg-brand-dark border border-brand-border rounded-lg p-3"><dt class="text-xs text-brand-muted">Contacto al empezar</dt><dd class="text-sm text-white font-semibold mt-0.5">{perfil.contacto}</dd></div>
              <div class="bg-brand-dark border border-brand-border rounded-lg p-3"><dt class="text-xs text-brand-muted">Edad habitual de entrada</dt><dd class="text-sm text-white font-semibold mt-0.5">{perfil.edad}</dd></div>
              <div class="bg-brand-dark border border-brand-border rounded-lg p-3"><dt class="text-xs text-brand-muted">Primera compra</dt><dd class="text-sm text-white font-semibold mt-0.5">{perfil.equipacion}</dd></div>
            </dl>
            <ol class="mt-4 space-y-2 text-sm text-brand-muted list-decimal pl-5">{guia.primeraClase.map(p => <li>{p}</li>)}</ol>
            <p class="text-xs text-brand-muted/80 mt-4">Es lo habitual en la disciplina, no la descripción de este centro. <a href={url.disciplina('es', dGuia)} class="text-brand-redtext hover:text-red-400">Más sobre {minus(nombreDisciplina(dGuia, 'es'))} en Cataluña →</a></p>
          </section>
        )}

        <section class="border border-brand-border rounded-xl p-5 text-sm">
          <h2 class="text-xs uppercase tracking-wide text-brand-muted font-semibold mb-2">{L(lang, 'De dónde salen estos datos', "D'on surten aquestes dades")}</h2>
          <p class="text-white/90">
            <a href={fuenteHref} target="_blank" rel="noopener nofollow" class="underline underline-offset-2 hover:text-brand-redtext" data-evento="clic_fuente">{fuenteLabel}</a>{nRegistro && <span class="text-brand-muted"> ({L(lang, 'n.º de inscripción', "núm. d'inscripció")} {nRegistro})</span>}
            <span class="text-brand-muted"> · {c.fuenteTipo === 'registro-oficial' ? L(lang, 'consultado el', 'consultat el') : L(lang, 'verificado el', 'verificat el')} {fecha(lang, c.verificado)}</span>
          </p>
          {c.fuenteTipo === 'registro-oficial' && <p class="text-brand-muted mt-2">{L(lang, 'El registro confirma que la entidad está inscrita, no que siga dando clases: compruébalo con el club.', "El registre confirma que l'entitat hi és inscrita, no que continuï fent classes: comprova-ho amb el club.")}</p>}
          <p class="text-brand-muted mt-2">{L(lang, 'No publicamos horarios, precios ni valoraciones: cambian y no podemos garantizarlos. Consulta siempre la web o la fuente del centro.', 'No publiquem horaris, preus ni valoracions: canvien i no els podem garantir. Consulta sempre el web o la font del centre.')}</p>
        </section>
      </div>

      <aside class="space-y-4 lg:sticky lg:top-24">
        <section id="pedir-info" class="scroll-mt-24 bg-brand-gray border border-brand-border rounded-2xl p-5 sm:p-6">
          <h2 class="text-lg font-bold text-white">{L(lang, 'Pedir información', 'Demanar informació')}</h2>
          <p class="text-sm text-brand-muted mt-1 mb-4">{c.web
            ? L(lang, `Escribe aquí y se la hacemos llegar a ${c.nombre}, o contacta desde su web.`, `Escriu aquí i la hi fem arribar a ${c.nombre}, o contacta des del seu web.`)
            : L(lang, `${c.nombre} no tiene web conocida: escribe aquí y se la hacemos llegar.`, `${c.nombre} no té web coneguda: escriu aquí i la hi fem arribar.`)}</p>
          <Formulario lang={lang} modo="info" estrecho centro={{ nombre: c.nombre, municipio: mun.nombre }} />
        </section>
        {verif && (
          <details class="border border-brand-border rounded-xl p-4" data-evento-abrir="abrir_sello">
            <summary class="cursor-pointer text-sm font-semibold text-white">{L(lang, 'Sello para la web del centro', 'Segell per al web del centre')}</summary>
            <p class="text-xs text-brand-muted mt-2">{L(lang, 'Si es tu centro, puedes poner este sello en tu web: enlaza a esta ficha y muestra que tus datos están comprobados. Gratis.', 'Si és el teu centre, pots posar aquest segell al teu web: enllaça a aquesta fitxa i mostra que les dades estan comprovades. Gratis.')}</p>
            <img src={`/sello/ficha-verificada-${lang}.svg`} alt="" width="220" height="56" class="mt-3" loading="lazy" />
            <textarea readonly rows="4" class="mt-3 w-full bg-brand-dark border border-brand-border rounded-lg p-2 text-[11px] text-brand-muted font-mono" aria-label={L(lang, 'Código HTML del sello', 'Codi HTML del segell')} data-sello>{sello}</textarea>
            <button type="button" class="mt-2 text-sm font-semibold text-brand-redtext hover:text-red-400" data-copiar-sello>{L(lang, 'Copiar código', 'Copiar codi')}</button>
          </details>
        )}
        <div class="border border-brand-border rounded-xl p-4 flex items-center justify-between gap-3">
          <p class="text-sm text-brand-muted"><span class="block font-semibold text-white">{L(lang, '¿Es tu centro?', 'És el teu centre?')}</span>{L(lang, 'Corrige o completa la ficha gratis.', 'Corregeix o completa la fitxa gratis.')}</p>
          <a href={`${url.paraCentros(lang)}?centro=${encodeURIComponent(c.nombre)}&municipio=${encodeURIComponent(mun.nombre)}&ficha=${c.slug}`} class="shrink-0 text-sm font-semibold text-brand-redtext hover:text-red-400" rel="nofollow" data-evento="gestionar_ficha" data-centro={c.slug}>{L(lang, 'Gestionar', 'Gestionar')} →</a>
        </div>
      </aside>
    </div>

    {(vecinos.length > 0 || parecidos.length > 0) && (
      <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
        <h2 class="text-xl font-bold text-white mb-5">{vecinos.length ? L(lang, `Otros centros en ${mun.nombre}`, `Altres centres a ${mun.nombre}`) : L(lang, 'Otros centros cerca', 'Altres centres a prop')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {vecinos.map(v => <CentroCard centro={v} lang={lang} conMunicipio={false} />)}
          {parecidos.map(({ centro, km }) => <CentroCard centro={centro} lang={lang} km={km} />)}
        </div>
      </section>
    )}

    <GuiasRelacionadas lang={lang} disciplinas={c.disciplinas} comarca={c.comarca} infantil={c.infantil} />

    <script>
      document.querySelector('[data-copiar-sello]')?.addEventListener('click', async e => {
        const t = document.querySelector<HTMLTextAreaElement>('[data-sello]')!;
        try { await navigator.clipboard.writeText(t.value); (e.target as HTMLElement).textContent = '✓'; } catch { t.select(); }
      });
    </script>
    <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-brand-dark/95 backdrop-blur-sm border-t border-brand-border p-3 flex gap-2">
      {c.web && <a href={c.web} target="_blank" rel={promo ? 'sponsored noopener' : 'noopener'} class="flex-1 text-center bg-white/5 border border-brand-border text-white text-sm font-semibold py-3 rounded-lg" data-evento="clic_web_centro" data-centro={c.slug}>{L(lang, 'Su web', 'El seu web')} ↗</a>}
      <a href="#pedir-info" class="flex-1 text-center bg-brand-red text-white text-sm font-semibold py-3 rounded-lg" data-evento="abrir_pedir_info" data-centro={c.slug}>{L(lang, 'Pedir información', 'Demanar informació')}</a>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
