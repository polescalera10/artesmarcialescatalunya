---
// Página de municipio. Si hay texto editorial propio (heredado del Garraf) se
// usa; si no, el texto sale de los datos y solo afirma lo que los datos dicen.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Migas from '../components/Migas.astro';
import ListaCentros from '../components/ListaCentros.astro';
import CentroCard from '../components/CentroCard.astro';
import FAQ from '../components/FAQ.astro';
import ParaCentrosCTA from '../components/ParaCentrosCTA.astro';
import GuiasRelacionadas from '../components/GuiasRelacionadas.astro';
import FiltroDisciplinas from '../components/FiltroDisciplinas.astro';
import { L, url, lista, titulo, descripcion, n, type Lang, minus } from '../lib/i18n';
import { centrosDeMunicipio, centrosDeComarca, disciplinasPresentes, cercanos, verificados } from '../lib/centros';
import { getComarca, getMunicipio, distanciaKm } from '../lib/geo';
import { nombreDisciplina } from '../lib/disciplinas';
import { tienePaginaMunDisc, rutasMunicipio, editorialMunicipio } from '../lib/rutas';
import { reescribirEnlaces } from '../lib/editorial';
import { deComarca } from '../lib/textos';
import { SITE, SCHEMA_IDS } from '../lib/site';
import { MUNICIPIS_CA } from '../garraf/ca';
import { conDatos } from '../garraf/recuentos';

interface Props { lang: Lang; comarca: string; municipio: string }
const { lang, comarca, municipio } = Astro.props;
const com = getComarca(comarca)!;
const mun = getMunicipio(municipio)!;
const centros = centrosDeMunicipio(municipio);
const disc = disciplinasPresentes(centros);
const nV = verificados(centros).length;
const nR = centros.length - nV;
const top = disciplinasPresentes(verificados(centros)).slice(0, 4).map(d => minus(nombreDisciplina(d.slug, lang)));
const cerca = cercanos(mun, () => true, 6, 25);

// Texto propio: castellano del sitio del Garraf; catalán del piloto /ca/.
const ed = lang === 'es' ? editorialMunicipio(comarca, municipio) : null;
const edCa = lang === 'ca' && comarca === 'garraf' && MUNICIPIS_CA[municipio]
  ? { intro: conDatos(MUNICIPIS_CA[municipio].intro, 'ca'), cos: reescribirEnlaces(conDatos(MUNICIPIS_CA[municipio].cos, 'ca')) }
  : null;

const vecinos = rutasMunicipio().filter(r => r.comarca === comarca && r.municipio !== municipio).map(r => getMunicipio(r.municipio)!);

// Intro con datos propios del municipio (solo verificados), para que cada
// página diga algo distinto: clases para niños, webs, la disciplina que más
// pesa aquí frente a la comarca y el municipio cercano con más oferta.
const ver = verificados(centros);
const nInf = ver.filter(c => c.infantil).length;
const nWeb = ver.filter(c => c.web).length;
const verCom = verificados(centrosDeComarca(comarca));
const destaca = disciplinasPresentes(ver)
  .map(d => ({ ...d, total: verCom.filter(c => c.disciplinas.includes(d.slug)).length }))
  .filter(d => d.n >= 2 && d.total > d.n)
  .sort((a, b) => b.n / b.total - a.n / a.total || b.n - a.n)[0];
const masOferta = rutasMunicipio()
  .filter(r => r.municipio !== municipio)
  .map(r => ({ m: getMunicipio(r.municipio)!, comarca: r.comarca, k: verificados(centrosDeMunicipio(r.municipio)).length }))
  .map(x => ({ ...x, km: distanciaKm(mun, x.m) }))
  .filter(x => x.km <= 25 && x.k > nV)
  .sort((a, b) => a.km - b.km)[0];
const frases = (lang === 'es'
  ? [
      `En ${mun.nombre} constan ${n(nV, 'centro verificado', 'centros verificados')} de artes marciales${top.length ? `; lo que más se ofrece es ${lista(lang, top)}` : ''}.`,
      nInf ? `${nInf === nV ? (nV === 1 ? 'Anuncia' : 'Todos anuncian') : `${nInf} de ellos anuncia${nInf === 1 ? '' : 'n'}`} clases para niños.` : '',
      nV > 1 && nWeb ? `${nWeb === nV ? 'Todos tienen' : `${nWeb} tiene${nWeb === 1 ? '' : 'n'}`} web propia para consultar horarios y precios.` : '',
      destaca ? `Para ${minus(nombreDisciplina(destaca.slug, 'es'))}, ${mun.nombre} reúne ${destaca.n} de los ${destaca.total} centros que la ofrecen en ${com.nombre}.` : '',
      masOferta ? `Si quieres más opciones, ${masOferta.m.nombre}, a unos ${Math.round(masOferta.km)} km, tiene ${masOferta.k}.` : '',
    ]
  : [
      `A ${mun.nombre} hi consten ${n(nV, 'centre verificat', 'centres verificats')} d'arts marcials${top.length ? `; el que més s'ofereix és ${lista(lang, top)}` : ''}.`,
      nInf ? `${nInf === nV ? (nV === 1 ? 'Anuncia' : 'Tots anuncien') : `${nInf} d'aquests ${nInf === 1 ? 'anuncia' : 'anuncien'}`} classes per a infants.` : '',
      nV > 1 && nWeb ? `${nWeb === nV ? 'Tots tenen' : `${nWeb} té${nWeb === 1 ? '' : 'nen'}`.replace('ténen', 'tenen')} web pròpia per consultar horaris i preus.` : '',
      destaca ? `Per a ${minus(nombreDisciplina(destaca.slug, 'ca'))}, ${mun.nombre} aplega ${destaca.n} dels ${destaca.total} centres que l'ofereixen a ${com.nombre}.` : '',
      masOferta ? `Si vols més opcions, ${masOferta.m.nombre}, a uns ${Math.round(masOferta.km)} km, en té ${masOferta.k}.` : '',
    ]).filter(Boolean);
const generadoIntro = nV
  ? frases.join(' ')
  : centros.length
  ? L(lang,
      `En ${mun.nombre} solo constan clubs inscritos en el registro de la Generalitat, sin actividad confirmada. Abajo tienes también los centros verificados más cercanos.`,
      `A ${mun.nombre} només hi consten clubs inscrits al registre de la Generalitat, sense activitat confirmada. A sota també tens els centres verificats més propers.`)
  : L(lang,
      `En nuestro directorio no consta todavía ningún centro de artes marciales en ${mun.nombre}. Abajo tienes los más cercanos.`,
      `Al nostre directori encara no hi consta cap centre d'arts marcials a ${mun.nombre}. A sota tens els més propers.`);

const title = ed?.titulo ?? titulo(
  L(lang, `Artes Marciales en ${mun.nombre}: ${n(nV, 'centro', 'centros')} | ${com.nombre}`, `Arts Marcials a ${mun.nombre}: ${n(nV, 'centre', 'centres')} | ${com.nombre}`),
  L(lang, `Artes Marciales en ${mun.nombre}: ${n(nV, 'centro', 'centros')}`, `Arts Marcials a ${mun.nombre}: ${n(nV, 'centre', 'centres')}`),
  L(lang, `Artes Marciales en ${mun.nombre}`, `Arts Marcials a ${mun.nombre}`),
);
const description = ed?.descripcion ?? descripcion(
  L(lang,
    `${n(nV, 'centro', 'centros')} de artes marciales en ${mun.nombre} (${com.nombre}): ${lista(lang, top)}. Con fuente pública y fecha de verificación.`,
    `${n(nV, 'centre', 'centres')} d'arts marcials a ${mun.nombre} (${com.nombre}): ${lista(lang, top)}. Amb font pública i data de verificació.`),
  L(lang, `Centros de artes marciales en ${mun.nombre} (${com.nombre}), con fuente pública y fecha de verificación.`, `Centres d'arts marcials a ${mun.nombre} (${com.nombre}), amb font pública i data de verificació.`),
);
const h1 = ed?.h1 ?? L(lang, `Artes marciales en ${mun.nombre}`, `Arts marcials a ${mun.nombre}`);

const faq = ed?.faq?.length ? ed.faq : [
  {
    q: L(lang, `¿Cuántos centros de artes marciales hay en ${mun.nombre}?`, `Quants centres d'arts marcials hi ha a ${mun.nombre}?`),
    a: L(lang,
      `En nuestro directorio constan ${n(nV, 'centro', 'centros')} en ${mun.nombre}. Solo publicamos centros con una fuente pública verificable, así que puede haber alguno más que aún no hemos podido comprobar.`,
      `Al nostre directori hi consten ${n(nV, 'centre', 'centres')} a ${mun.nombre}. Només publiquem centres amb una font pública verificable, així que en pot haver algun més que encara no hem pogut comprovar.`),
  },
  ...(disc.length ? [{
    q: L(lang, `¿Qué artes marciales se pueden practicar en ${mun.nombre}?`, `Quines arts marcials es poden practicar a ${mun.nombre}?`),
    a: L(lang,
      `Según las fuentes de cada centro: ${lista(lang, disc.map(d => `${minus(nombreDisciplina(d.slug, lang))} (${d.n})`))}. El número indica cuántos centros la anuncian.`,
      `Segons les fonts de cada centre: ${lista(lang, disc.map(d => `${minus(nombreDisciplina(d.slug, lang))} (${d.n})`))}. El número indica quants centres l'anuncien.`),
  }] : []),
];

const alternates = { es: url.municipio('es', comarca, municipio), ca: url.municipio('ca', comarca, municipio) };
const pageUrl = `${SITE.url}${url.municipio(lang, comarca, municipio)}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': pageUrl,
  name: title,
  description,
  url: pageUrl,
  inLanguage: lang,
  isPartOf: { '@id': SCHEMA_IDS.website },
  publisher: { '@id': SCHEMA_IDS.organization },
  about: { '@type': 'City', name: mun.nombre, containedInPlace: { '@type': 'AdministrativeArea', name: com.nombre } },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: centros.length,
    itemListElement: centros.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${url.centro(lang, c.slug)}`, name: c.nombre })),
  },
};
---

<Layout ogImage={`${SITE.url}/og/c/${comarca}-${lang}.jpg`} title={title} description={description} canonical={url.municipio(lang, comarca, municipio)} schema={schema} lang={lang} alternates={alternates}>
  <Header lang={lang} alt={alternates[lang === 'es' ? 'ca' : 'es']} />
  <main id="contenido">
    <Migas lang={lang} items={[{ nombre: com.nombre, href: url.comarca(lang, comarca) }, { nombre: mun.nombre, href: url.municipio(lang, comarca, municipio) }]} />

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-6">
      <p class="text-xs uppercase tracking-wide text-brand-redtext font-semibold mb-3">{mun.nombre} · {com.nombre}</p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight">{h1}</h1>
      <div class="text-lg text-brand-muted mt-4 max-w-3xl leading-relaxed" set:html={ed?.intro ?? edCa?.intro ?? generadoIntro} />
      {nR > 0 && (
        <p class="text-sm text-brand-muted mt-3 max-w-3xl">
          {L(lang,
            `Además constan ${n(nR, 'club inscrito', 'clubs inscritos')} en el registro de la Generalitat cuya actividad no hemos podido confirmar: los verás al final del listado.`,
            `A més hi consten ${n(nR, 'club inscrit', 'clubs inscrits')} al registre de la Generalitat l'activitat dels quals no hem pogut confirmar: els veuràs al final del llistat.`)}
        </p>
      )}
    </section>

    {disc.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <h2 class="text-lg font-bold text-white mb-3">{L(lang, `Disciplinas en ${mun.nombre}`, `Disciplines a ${mun.nombre}`)}</h2>
        <ul class="flex flex-wrap gap-2">
          {disc.map(d => (
            <li>
              {tienePaginaMunDisc(municipio, d.slug) ? (
                <a href={url.munDisc(lang, comarca, municipio, d.slug)} class="inline-flex items-center gap-2 bg-brand-gray border border-brand-border rounded-full px-3 py-1.5 text-sm text-brand-muted hover:text-white hover:border-brand-red/40">
                  {nombreDisciplina(d.slug, lang)} <span class="text-white font-semibold">{d.n}</span>
                </a>
              ) : (
                <span class="inline-flex items-center gap-2 bg-brand-gray border border-brand-border rounded-full px-3 py-1.5 text-sm text-brand-muted">
                  {nombreDisciplina(d.slug, lang)} <span class="text-white font-semibold">{d.n}</span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    {centros.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" id="lista-centros">
        <h2 class="text-2xl font-bold text-white mb-4">{L(lang, `Centros en ${mun.nombre}`, `Centres a ${mun.nombre}`)} <span class="text-brand-muted font-normal">({centros.length})</span></h2>
        <FiltroDisciplinas lang={lang} disciplinas={disc} ambito="lista-centros" infantil={centros.filter(c => c.infantil).length} cerca={{ comarca, municipio }} />
        <ListaCentros centros={centros} lang={lang} conMunicipio={false} />
        <p class="text-xs text-brand-muted mt-4">{L(lang, 'Orden alfabético. No valoramos ni ordenamos por calidad.', 'Ordre alfabètic. No valorem ni ordenem per qualitat.')}</p>
      </section>
    )}

    {(ed?.body || edCa?.cos) && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <article class="max-w-3xl articulo" set:html={ed?.body ?? edCa!.cos} />
      </section>
    )}

    {cerca.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <h2 class="text-xl font-bold text-white mb-2">{L(lang, `Cerca de ${mun.nombre}`, `A prop de ${mun.nombre}`)}</h2>
        <p class="text-sm text-brand-muted mb-5">{L(lang, 'Distancia en línea recta entre centros de municipio, orientativa.', 'Distància en línia recta entre centres de municipi, orientativa.')}</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {cerca.map(({ centro, km }) => <CentroCard centro={centro} lang={lang} km={km} />)}
        </div>
      </section>
    )}

    {vecinos.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <h2 class="text-lg font-bold text-white mb-3">{L(lang, `Otros municipios ${deComarca('es', comarca)}`, `Altres municipis ${deComarca('ca', comarca)}`)}</h2>
        <ul class="flex flex-wrap gap-2">
          {vecinos.map(v => (
            <li><a href={url.municipio(lang, comarca, v.slug)} class="inline-block bg-brand-gray border border-brand-border rounded-lg px-3 py-1.5 text-sm text-brand-muted hover:text-white">{v.nombre}</a></li>
          ))}
          <li><a href={url.comarca(lang, comarca)} class="inline-block px-3 py-1.5 text-sm text-brand-redtext hover:text-red-400">{L(lang, `Toda la comarca`, `Tota la comarca`)} →</a></li>
        </ul>
      </section>
    )}

    <GuiasRelacionadas lang={lang} comarca={comarca} />
    <ParaCentrosCTA lang={lang} ambito={mun.nombre} />
    <FAQ items={faq} title={L(lang, 'Preguntas frecuentes', 'Preguntes freqüents')} />
  </main>
  <Footer lang={lang} />
</Layout>
