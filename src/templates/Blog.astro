---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Migas from '../components/Migas.astro';
import { url, fecha, L, type Lang } from '../lib/i18n';
import { articulos, articulosCa } from '../lib/blog';
import { SITE, SCHEMA_IDS } from '../lib/site';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
// En catalán solo están los artículos más consultados: van todos en una lista.
const POSTS = lang === 'ca' ? await articulosCa() : await articulos();
const articulosBlog = POSTS.filter(p => lang === 'ca' || p.tipo === 'articulo');
const guias = lang === 'ca' ? [] : POSTS.filter(p => p.tipo === 'guia');
const title = L(lang, 'Blog de artes marciales: guías para empezar', "Blog d'arts marcials: guies per començar");
const description = L(lang,
  'Qué arte marcial elegir, a qué edad empezar, cómo es la primera clase y cómo comparar centros en Cataluña. Guías prácticas, sin publicidad.',
  'Quin art marcial triar, a quina edat començar, com és la primera classe i com comparar centres a Catalunya. Guies pràctiques, sense publicitat.');
const alternates = { es: url.blog('es'), ca: url.blog('ca') };
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE.url}${url.blog(lang)}`,
  name: title,
  description,
  url: `${SITE.url}${url.blog(lang)}`,
  inLanguage: lang,
  isPartOf: { '@id': SCHEMA_IDS.website },
  publisher: { '@id': SCHEMA_IDS.organization },
};
---

<Layout title={title} description={description} canonical={url.blog(lang)} schema={schema} lang={lang} alternates={alternates}>
  <Header lang={lang} alt={alternates[lang === 'es' ? 'ca' : 'es']} />
  <main id="contenido">
    <Migas lang={lang} items={[{ nombre: 'Blog', href: url.blog(lang) }]} />
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-6">
      <h1 class="text-3xl sm:text-4xl font-black text-white leading-tight">Blog</h1>
      <p class="text-lg text-brand-muted mt-3 max-w-3xl">{description}</p>
      {lang === 'ca' && <p class="text-sm text-brand-muted mt-3 max-w-3xl">Hem traduït els articles més consultats. La resta, de moment, és <a href={url.blog('es')} class="text-brand-redtext hover:text-red-400 underline">en castellà</a>.</p>}
    </section>
    {[[L(lang, 'Artículos', 'Articles'), articulosBlog], [L(lang, 'Guías por perfil y objetivo', 'Guies per perfil i objectiu'), guias]].filter(([, ps]) => (ps as typeof POSTS).length).map(([t, ps]) => (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <h2 class="text-xl font-bold text-white mb-4">{t}</h2>
        <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {(ps as typeof POSTS).map(p => (
            <li class="bg-brand-gray border border-brand-border rounded-xl p-5 flex flex-col gap-2">
              <a href={url.post(p.slug, lang)} class="font-semibold text-white hover:text-brand-redtext">{p.h1}</a>
              <p class="text-sm text-brand-muted line-clamp-3">{p.descripcion}</p>
              {p.tipo === 'articulo' && <time datetime={p.fecha} class="text-xs text-brand-muted/80 mt-auto">{fecha(lang, p.fecha)}</time>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
  <Footer lang={lang} />
</Layout>
