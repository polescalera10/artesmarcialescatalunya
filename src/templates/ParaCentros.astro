---
// Página comercial para centros: alta y correcciones gratis; promocionado,
// web y SEO local de pago. Precios "desde", IVA aparte (Pol, 04-10-2026).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Migas from '../components/Migas.astro';
import FAQ from '../components/FAQ.astro';
import Formulario from '../components/Formulario.astro';
import { L, url, type Lang } from '../lib/i18n';
import { CENTROS, comarcasConCentros, verificados } from '../lib/centros';
// Recuento público: solo centros con actividad verificada (no los del registro).
const NV = verificados(CENTROS).length;
import { SITE, SCHEMA_IDS } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const sinWeb = CENTROS.filter(c => !c.web).length;

const title = L(lang, 'Para centros de artes marciales: alta gratis y promoción', "Per a centres d'arts marcials: alta gratis i promoció");
const description = L(lang,
  'Añade o corrige gratis la ficha de tu centro en el directorio de artes marciales de Cataluña. Y si quieres destacar o no tienes web, te ayudamos.',
  "Afegeix o corregeix gratis la fitxa del teu centre al directori d'arts marcials de Catalunya. I si vols destacar o no tens web, t'ajudem.");

const bloques = [
  {
    titulo: L(lang, 'Ficha gratuita', 'Fitxa gratuïta'),
    precio: L(lang, 'Gratis, siempre', 'Gratis, sempre'),
    texto: L(lang,
      'Todos los centros con una fuente pública aparecen en el directorio sin pagar nada. Si falta el tuyo o algún dato está mal, escríbenos y lo corregimos.',
      "Tots els centres amb una font pública surten al directori sense pagar res. Si hi falta el teu o alguna dada està malament, escriu-nos i ho corregim."),
    cta: 'alta',
  },
  {
    titulo: L(lang, 'Centro promocionado', 'Centre promocionat'),
    precio: L(lang, '19 €/mes por municipio · 39 €/mes por comarca', '19 €/mes per municipi · 39 €/mes per comarca'),
    texto: L(lang,
      'Tu ficha aparece también en un bloque destacado arriba de las páginas de tu comarca, tu municipio y tus disciplinas, con la etiqueta "Promocionado". El listado alfabético no cambia: nadie paga por estar más arriba en él.',
      "La teva fitxa apareix també en un bloc destacat a dalt de les pàgines de la teva comarca, el teu municipi i les teves disciplines, amb l'etiqueta \"Promocionat\". El llistat alfabètic no canvia: ningú paga per estar més amunt.")
    ,
    cta: 'promocion',
  },
  {
    titulo: L(lang, 'Web para tu centro', 'Web per al teu centre'),
    precio: L(lang, 'Desde 490 € + 15 €/mes', 'Des de 490 € + 15 €/mes'),
    texto: L(lang,
      `${sinWeb} centros del directorio no tienen web propia que hayamos podido encontrar. Si es tu caso, te hacemos una web rápida, pensada para aparecer en Google cuando alguien busca tu disciplina en tu municipio.`,
      `${sinWeb} centres del directori no tenen web pròpia que hàgim pogut trobar. Si és el teu cas, et fem un web ràpid, pensat per sortir a Google quan algú busca la teva disciplina al teu municipi.`),
    cta: 'web',
  },
  {
    titulo: L(lang, 'SEO local para gimnasios', 'SEO local per a gimnasos'),
    precio: L(lang, 'Desde 150 €/mes', 'Des de 150 €/mes'),
    texto: L(lang,
      'Ficha de Google Business Profile, páginas por disciplina y municipio, contenido y medición. Lo mismo que hacemos con este directorio, aplicado a tu centro.',
      'Fitxa de Google Business Profile, pàgines per disciplina i municipi, contingut i mesura. El mateix que fem amb aquest directori, aplicat al teu centre.'),
    cta: 'seo',
  },
];

const ventajas: [string, string][] = [
  [L(lang, 'Arriba en las páginas donde te buscan', 'A dalt de les pàgines on et busquen'),
   L(lang, 'Tu municipio, tu comarca (si eliges comarca) y las páginas de tus disciplinas allí.', 'El teu municipi, la teva comarca (si tries comarca) i les pàgines de les teves disciplines allà.')],
  [L(lang, 'Consultas de alumnos', "Consultes d'alumnes"),
   L(lang, 'Quien pulsa «Pedir información» en tu ficha nos deja su consulta y te la hacemos llegar, con su permiso.', "Qui prem «Demanar informació» a la teva fitxa ens deixa la consulta i te la fem arribar, amb el seu permís.")],
  [L(lang, 'Ficha completa y corregida', 'Fitxa completa i corregida'),
   L(lang, 'Revisamos contigo disciplinas, dirección, web y clases para niños, para que salgas en los filtros correctos.', 'Revisem amb tu disciplines, adreça, web i classes per a infants, perquè surtis als filtres correctes.')],
  [L(lang, 'Transparente para el usuario', "Transparent per a l'usuari"),
   L(lang, 'La etiqueta «Promocionado» está siempre visible. Así el directorio sigue siendo creíble, y tu destacado también.', "L'etiqueta «Promocionat» sempre és visible. Així el directori continua sent creïble, i el teu destacat també.")],
];
const pasos: [string, string][] = [
  [L(lang, 'Escríbenos', 'Escriu-nos'), L(lang, 'Con el formulario de abajo: centro, municipio y qué te interesa.', 'Amb el formulari de sota: centre, municipi i què t\'interessa.')],
  [L(lang, 'Te confirmamos por escrito', "T'ho confirmem per escrit"), L(lang, 'Revisamos tu ficha y te enviamos precio final y qué incluye antes de empezar.', 'Revisem la teva fitxa i et passem preu final i què inclou abans de començar.')],
  [L(lang, 'Lo activamos', "L'activem"), L(lang, 'Publicamos el destacado y te enviamos los enlaces donde aparece.', 'Publiquem el destacat i et passem els enllaços on surt.')],
];

const faq = [
  {
    q: L(lang, '¿Cuánto cuesta destacar mi centro?', 'Quant costa destacar el meu centre?'),
    a: L(lang,
      '19 € al mes (sin IVA) para aparecer destacado en la página de tu municipio y en las de tus disciplinas allí; 39 € al mes para toda tu comarca.',
      "19 € al mes (sense IVA) per sortir destacat a la pàgina del teu municipi i a les de les teves disciplines; 39 € al mes per a tota la comarca."),
  },
  {
    q: L(lang, '¿Tengo que pagar para aparecer?', 'He de pagar per aparèixer?'),
    a: L(lang,
      'No. El directorio incluye todos los centros que podemos verificar con una fuente pública, paguen o no. Pagar solo añade un bloque destacado y etiquetado; nunca cambia el orden del listado ni lo que decimos de otros centros.',
      "No. El directori inclou tots els centres que podem verificar amb una font pública, paguin o no. Pagar només afegeix un bloc destacat i etiquetat; mai no canvia l'ordre del llistat ni el que diem d'altres centres."),
  },
  {
    q: L(lang, '¿Qué datos publicáis de mi centro?', 'Quines dades publiqueu del meu centre?'),
    a: L(lang,
      'Nombre, municipio, disciplinas, dirección y web si constan en una fuente pública, y la fuente con su fecha. No publicamos teléfonos personales, nombres de instructores, precios ni valoraciones.',
      "Nom, municipi, disciplines, adreça i web si consten en una font pública, i la font amb la data. No publiquem telèfons personals, noms d'instructors, preus ni valoracions."),
  },
  {
    q: L(lang, 'Quiero que retiréis mi centro. ¿Se puede?', 'Vull que retireu el meu centre. Es pot?'),
    a: L(lang,
      'Sí. Escríbenos desde un correo del centro o indícanos cómo comprobar que eres el responsable y lo retiramos.',
      "Sí. Escriu-nos des d'un correu del centre o indica'ns com comprovar que n'ets el responsable i el retirem."),
  },
];

const alternates = { es: url.paraCentros('es'), ca: url.paraCentros('ca') };
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE.url}${url.paraCentros(lang)}`,
  name: title,
  description,
  url: `${SITE.url}${url.paraCentros(lang)}`,
  inLanguage: lang,
  isPartOf: { '@id': SCHEMA_IDS.website },
  publisher: { '@id': SCHEMA_IDS.organization },
};
---

<Layout title={title} description={description} canonical={url.paraCentros(lang)} schema={schema} lang={lang} alternates={alternates}>
  <Header lang={lang} alt={alternates[lang === 'es' ? 'ca' : 'es']} />
  <main id="contenido">
    <Migas lang={lang} items={[{ nombre: L(lang, 'Para centros', 'Per a centres'), href: url.paraCentros(lang) }]} />

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-6">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight max-w-3xl">
        {L(lang, 'Tu centro, donde te buscan', 'El teu centre, on et busquen')}
      </h1>
      <p class="text-lg text-brand-muted mt-4 max-w-3xl leading-relaxed">
        {L(lang,
          `Artes Marciales Catalunya reúne ${NV} centros de ${comarcasConCentros().length} comarcas, cada uno con su fuente pública. Aparecer es gratis. Si además quieres destacar o necesitas web, te lo contamos aquí.`,
          `Arts Marcials Catalunya reuneix ${NV} centres de ${comarcasConCentros().length} comarques, cadascun amb la seva font pública. Sortir-hi és gratis. Si a més vols destacar o necessites web, t'ho expliquem aquí.`)}
      </p>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {bloques.map(b => (
        <div class="bg-brand-gray border border-brand-border rounded-xl p-6 flex flex-col gap-3">
          <p class="text-xs uppercase tracking-wide text-brand-red font-semibold">{b.precio}</p>
          <h2 class="text-lg font-bold text-white">{b.titulo}</h2>
          <p class="text-sm text-brand-muted leading-relaxed">{b.texto}</p>
          <a href={`?tipo=${b.cta}#formulario`} class="mt-auto text-sm font-semibold text-brand-red hover:text-red-400" data-tipo={b.cta}>{L(lang, 'Me interesa', "M'interessa")} →</a>
        </div>
      ))}
    </section>
    <p class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-xs text-brand-muted">
      {L(lang,
        'Precios sin IVA. El precio final de web y SEO depende de lo que necesites; te lo decimos por escrito antes de empezar.',
        "Preus sense IVA. El preu final de web i SEO depèn del que necessitis; t'ho diem per escrit abans de començar.")}
    </p>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid lg:grid-cols-2 gap-10 items-start">
      <div>
        <h2 class="text-2xl font-bold text-white">{L(lang, 'Qué consigue un centro promocionado', 'Què aconsegueix un centre promocionat')}</h2>
        <ul class="mt-5 space-y-4">
          {ventajas.map(([t, d]) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="mt-1 shrink-0 w-5 h-5 rounded-full bg-emerald-500/15 text-emerald-300 grid place-items-center text-xs">✓</span>
              <span><span class="block font-semibold text-white">{t}</span><span class="block text-sm text-brand-muted mt-0.5">{d}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <figure>
        <figcaption class="text-xs uppercase tracking-wide text-brand-muted mb-3">{L(lang, 'Ejemplo de ficha destacada (centro ficticio)', 'Exemple de fitxa destacada (centre fictici)')}</figcaption>
        <div class="bg-brand-gray border border-amber-500/50 rounded-xl p-5 flex flex-col gap-3" aria-hidden="true">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="font-bold text-white leading-snug">{L(lang, 'Tu centro', 'El teu centre')}</p>
              <p class="text-xs text-brand-muted mt-0.5">{L(lang, 'Tu municipio', 'El teu municipi')}</p>
            </div>
            <span class="shrink-0 text-[10px] uppercase tracking-wide font-semibold text-amber-400 border border-amber-500/40 rounded px-1.5 py-0.5">{L(lang, 'Promocionado', 'Promocionat')}</span>
          </div>
          <ul class="flex flex-wrap gap-1.5 text-xs text-brand-muted">
            <li class="bg-brand-dark border border-brand-border rounded-full px-2.5 py-0.5">Judo</li>
            <li class="bg-brand-dark border border-brand-border rounded-full px-2.5 py-0.5">{L(lang, 'Defensa personal', 'Defensa personal')}</li>
          </ul>
          <p class="text-xs text-sky-300">{L(lang, 'Anuncia clases para niños', 'Anuncia classes per a infants')}</p>
          <div class="pt-2 border-t border-brand-border flex items-center justify-between text-xs">
            <span class="font-semibold text-brand-red">{L(lang, 'Ver ficha', 'Veure fitxa')} →</span>
            <span class="text-brand-muted">{L(lang, 'Web del centro', 'Web del centre')} ↗</span>
          </div>
        </div>
        <p class="text-xs text-brand-muted mt-3">{L(lang, 'Aparece en un bloque aparte, encima del listado y con la etiqueta «Promocionado». El listado alfabético no cambia.', "Surt en un bloc a part, damunt del llistat i amb l'etiqueta «Promocionat». El llistat alfabètic no canvia.")}</p>
      </figure>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <h2 class="text-2xl font-bold text-white mb-5">{L(lang, 'Cómo funciona', 'Com funciona')}</h2>
      <ol class="grid md:grid-cols-3 gap-5">
        {pasos.map(([t, d], i) => (
          <li class="bg-brand-gray border border-brand-border rounded-xl p-5">
            <span class="text-brand-red font-black text-2xl">{i + 1}</span>
            <p class="font-semibold text-white mt-2">{t}</p>
            <p class="text-sm text-brand-muted mt-1">{d}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="formulario" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 scroll-mt-24">
      <h2 class="text-2xl font-bold text-white mb-2">{L(lang, 'Escríbenos', 'Escriu-nos')}</h2>
      <p class="text-sm text-brand-muted mb-6">{L(lang, 'Respondemos por email en uno o dos días laborables.', 'Responem per email en un o dos dies feiners.')}</p>
      <div class="bg-brand-gray border border-brand-border rounded-xl p-6">
        <Formulario lang={lang} modo="centro" />
      </div>
    </section>

    <FAQ items={faq} title={L(lang, 'Preguntas frecuentes', 'Preguntes freqüents')} />
  </main>
  <Footer lang={lang} />
</Layout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-tipo]').forEach(a => a.addEventListener('click', () => {
    const sel = document.querySelector<HTMLSelectElement>('#f-tipo');
    if (sel) sel.value = a.dataset.tipo!;
  }));
</script>
