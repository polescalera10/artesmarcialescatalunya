---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Migas from '../components/Migas.astro';
import Formulario from '../components/Formulario.astro';
import { L, url, type Lang } from '../lib/i18n';
import { SITE, SCHEMA_IDS } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const title = L(lang, 'Contacto | Artes Marciales Catalunya', 'Contacte | Arts Marcials Catalunya');
const description = L(lang,
  '¿Buscas dónde entrenar o has visto un dato incorrecto en el directorio? Escríbenos. Si tienes un centro, mira la página para centros.',
  "Busques on entrenar o has vist una dada incorrecta al directori? Escriu-nos. Si tens un centre, mira la pàgina per a centres.");
const alternates = { es: url.contacto('es'), ca: url.contacto('ca') };
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${SITE.url}${url.contacto(lang)}`,
  name: title,
  description,
  url: `${SITE.url}${url.contacto(lang)}`,
  inLanguage: lang,
  isPartOf: { '@id': SCHEMA_IDS.website },
  publisher: { '@id': SCHEMA_IDS.organization },
};
---

<Layout title={title} description={description} canonical={url.contacto(lang)} schema={schema} lang={lang} alternates={alternates}>
  <Header lang={lang} alt={alternates[lang === 'es' ? 'ca' : 'es']} />
  <main id="contenido">
    <Migas lang={lang} items={[{ nombre: L(lang, 'Contacto', 'Contacte'), href: url.contacto(lang) }]} />
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12">
      <h1 class="text-3xl sm:text-4xl font-black text-white leading-tight">{L(lang, 'Contacto', 'Contacte')}</h1>
      <p class="text-brand-muted mt-3 leading-relaxed">
        {L(lang, '¿Tienes un centro? Te atendemos mejor desde ', 'Tens un centre? T’atenem millor des de ')}
        <a href={url.paraCentros(lang)} class="text-brand-red underline">{L(lang, 'la página para centros', 'la pàgina per a centres')}</a>.
        {L(lang, ` También puedes escribir directamente a ${SITE.email}.`, ` També pots escriure directament a ${SITE.email}.`)}
      </p>
      <div class="bg-brand-gray border border-brand-border rounded-xl p-6 mt-8">
        <Formulario lang={lang} modo="visitante" />
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
