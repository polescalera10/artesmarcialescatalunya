---
// Directorio completo con filtro en el navegador. Las filas están en el HTML
// (indexables y funcionan sin JavaScript); el script solo las oculta.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Migas from '../components/Migas.astro';
import ParaCentrosCTA from '../components/ParaCentrosCTA.astro';
import { L, url, n, type Lang } from '../lib/i18n';
import { CENTROS, comarcasConCentros, disciplinasPresentes, esPromocionado } from '../lib/centros';
import { getComarca, getMunicipio } from '../lib/geo';
import { nombreDisciplina } from '../lib/disciplinas';
import { SITE, SCHEMA_IDS } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const comarcas = comarcasConCentros().map(slug => ({ slug, nombre: getComarca(slug)!.nombre }));
const disc = disciplinasPresentes(CENTROS);
const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

const title = L(lang, `Directorio de artes marciales en Cataluña: ${CENTROS.length} centros`, `Directori d'arts marcials a Catalunya: ${CENTROS.length} centres`);
const description = L(lang,
  `Los ${CENTROS.length} centros de artes marciales del directorio, filtrables por comarca, municipio, disciplina y nombre. Cada uno con su fuente pública y fecha de verificación.`,
  `Els ${CENTROS.length} centres d'arts marcials del directori, filtrables per comarca, municipi, disciplina i nom. Cadascun amb la seva font pública i data de verificació.`);
const alternates = { es: url.centros('es'), ca: url.centros('ca') };
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE.url}${url.centros(lang)}`,
  name: title,
  description,
  url: `${SITE.url}${url.centros(lang)}`,
  inLanguage: lang,
  isPartOf: { '@id': SCHEMA_IDS.website },
  publisher: { '@id': SCHEMA_IDS.organization },
};
const sel = 'bg-brand-gray border border-brand-border rounded-lg px-3 py-2.5 text-sm text-white focus:outline-none focus:border-brand-red';
---

<Layout title={title} description={description} canonical={url.centros(lang)} schema={schema} lang={lang} alternates={alternates}>
  <Header lang={lang} alt={alternates[lang === 'es' ? 'ca' : 'es']} />
  <main id="contenido">
    <Migas lang={lang} items={[{ nombre: L(lang, 'Centros', 'Centres'), href: url.centros(lang) }]} />
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <h1 class="text-3xl sm:text-4xl font-black text-white leading-tight">{L(lang, 'Todos los centros', 'Tots els centres')}</h1>
      <p class="text-brand-muted mt-3 max-w-3xl">
        {L(lang,
          `${n(CENTROS.length, 'centro', 'centros')} en orden alfabético. Elige comarca y municipio, y después filtra por disciplina o busca por nombre.`,
          `${n(CENTROS.length, 'centre', 'centres')} en ordre alfabètic. Tria comarca i municipi, i després filtra per disciplina o cerca pel nom.`)}
      </p>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sticky top-16 z-40 bg-brand-dark/95 backdrop-blur" data-filtros>
      <div class="grid sm:grid-cols-2 lg:grid-cols-[1fr_auto_auto_auto] gap-3">
        <label class="sr-only" for="f-q">{L(lang, 'Buscar', 'Cercar')}</label>
        <input id="f-q" type="search" placeholder={L(lang, 'Nombre, municipio o disciplina', 'Nom, municipi o disciplina')} class={sel} />
        <label class="sr-only" for="f-comarca">{L(lang, 'Comarca', 'Comarca')}</label>
        <select id="f-comarca" class={sel}>
          <option value="">{L(lang, 'Todas las comarcas', 'Totes les comarques')}</option>
          {comarcas.map(c => <option value={c.slug}>{c.nombre}</option>)}
        </select>
        <label class="sr-only" for="f-municipio">{L(lang, 'Municipio', 'Municipi')}</label>
        <select id="f-municipio" class={sel} disabled>
          <option value="">{L(lang, 'Todos los municipios', 'Tots els municipis')}</option>
        </select>
        <label class="sr-only" for="f-disc">{L(lang, 'Disciplina', 'Disciplina')}</label>
        <select id="f-disc" class={sel}>
          <option value="">{L(lang, 'Todas las disciplinas', 'Totes les disciplines')}</option>
          {disc.map(d => <option value={d.slug} data-nombre={nombreDisciplina(d.slug, lang)}>{nombreDisciplina(d.slug, lang)} ({d.n})</option>)}
        </select>
      </div>
      <p class="text-xs text-brand-muted mt-2" aria-live="polite"><span data-cuenta>{CENTROS.length}</span> {L(lang, 'centros', 'centres')}</p>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <ul class="divide-y divide-brand-border border border-brand-border rounded-xl overflow-hidden" data-lista aria-live="polite"></ul>
      <button type="button" class="hidden mt-4 w-full sm:w-auto bg-brand-gray border border-brand-border hover:border-brand-red/40 text-white text-sm font-semibold px-5 py-2.5 rounded-lg" data-mas>
        {L(lang, 'Mostrar más', 'Mostra’n més')}
      </button>
      <p class="hidden text-brand-muted py-8 text-center" data-vacio>
        {L(lang, 'Ningún centro coincide. ¿Conoces uno que falte?', 'Cap centre no coincideix. En coneixes un que hi falti?')}
        <a href={url.paraCentros(lang)} class="text-brand-red underline">{L(lang, 'Avísanos', 'Avisa’ns')}</a>
      </p>
      <noscript>
        <p class="text-brand-muted mb-3">{L(lang, 'Para filtrar hace falta JavaScript. Puedes ver los centros por comarca:', 'Per filtrar cal JavaScript. Pots veure els centres per comarca:')}</p>
        <ul class="flex flex-wrap gap-2">{comarcas.map(c => <li><a href={url.comarca(lang, c.slug)} class="text-brand-red underline">{c.nombre}</a></li>)}</ul>
      </noscript>
    </section>

    <ParaCentrosCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<script define:vars={{ lang, prefijo: lang === 'ca' ? '/ca/centres/' : '/centros/', txtVer: lang === 'ca' ? 'Sense verificar' : 'Sin verificar' }}>
  // Filtro en cascada sobre /datos/centros.json: ubicación (comarca → municipio)
  // y, sobre ese resultado, disciplina; búsqueda por texto. Verificados primero.
  const PAGINA = 60;
  const q = document.querySelector('#f-q');
  const com = document.querySelector('#f-comarca');
  const mun = document.querySelector('#f-municipio');
  const dis = document.querySelector('#f-disc');
  const lista = document.querySelector('[data-lista]');
  const cuenta = document.querySelector('[data-cuenta]');
  const vacio = document.querySelector('[data-vacio]');
  const mas = document.querySelector('[data-mas]');
  const todosMunicipios = mun.options[0].text;
  const norm = s => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const esc = s => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const L = lang === 'ca' ? 1 : 0;
  let D = null, resultado = [], mostrados = 0, timer;

  fetch('/datos/centros.json').then(r => r.json()).then(datos => {
    D = datos;
    D.filas = D.centros.map(([slug, nombre, m, c, ds, v]) => ({
      slug, nombre, m, c, ds, v,
      t: norm([nombre, D.municipios[m], D.comarcas[c], ...ds.flatMap(d => D.disciplinas[d] || [])].join(' ')),
    }));
    D.filas.sort((a, b) => b.v - a.v || a.nombre.localeCompare(b.nombre, 'es'));
    const p = new URLSearchParams(location.search);
    q.value = p.get('q') ?? '';
    com.value = p.get('comarca') ?? '';
    rellenarMunicipios(p.get('municipio') ?? '');
    dis.value = p.get('disciplina') ?? '';
    filtrar(false);
  });

  function rellenarMunicipios(valor = '') {
    const vistos = new Map();
    if (D) for (const f of D.filas) if (f.c === com.value) vistos.set(f.m, D.municipios[f.m]);
    mun.innerHTML = '';
    mun.add(new Option(todosMunicipios, ''));
    [...vistos.entries()].sort((a, b) => a[1].localeCompare(b[1], 'ca')).forEach(([s, n]) => mun.add(new Option(n, s)));
    mun.disabled = !com.value;
    mun.value = vistos.has(valor) ? valor : '';
  }
  const enUbicacion = f => (!com.value || f.c === com.value) && (!mun.value || f.m === mun.value);

  function recontar() {
    const n = new Map();
    for (const f of D.filas) if (enUbicacion(f)) for (const d of f.ds) n.set(d, (n.get(d) ?? 0) + 1);
    for (const o of [...dis.options].slice(1)) {
      const k = n.get(o.value) ?? 0;
      o.text = `${o.dataset.nombre} (${k})`;
      o.hidden = o.disabled = k === 0;
    }
    if (dis.value && !n.get(dis.value)) dis.value = '';
  }

  function fila(f) {
    const ds = f.ds.map(d => (D.disciplinas[d] || [d])[L]).join(' · ');
    return `<li class="grid sm:grid-cols-[2fr_1fr_2fr] gap-1 sm:gap-4 px-4 py-3 bg-brand-gray/40 hover:bg-brand-gray">
      <a href="${prefijo}${f.slug}/" class="font-medium text-white hover:text-brand-red">${esc(f.nombre)}${f.v ? '' : ` <span class="ml-1 text-[10px] uppercase text-brand-muted border border-brand-border rounded px-1">${txtVer}</span>`}</a>
      <span class="text-sm text-brand-muted">${esc(D.municipios[f.m])}</span>
      <span class="text-xs text-brand-muted">${esc(ds)}</span></li>`;
  }
  function pintar(desde) {
    const trozo = resultado.slice(desde, desde + PAGINA);
    lista.insertAdjacentHTML('beforeend', trozo.map(fila).join(''));
    mostrados = desde + trozo.length;
    mas.classList.toggle('hidden', mostrados >= resultado.length);
  }

  function filtrar(medir = true) {
    if (!D) return;
    recontar();
    const palabras = norm(q.value).split(/\s+/).filter(Boolean);
    resultado = D.filas.filter(f => enUbicacion(f) && (!dis.value || f.ds.includes(dis.value)) && palabras.every(p => f.t.includes(p)));
    lista.innerHTML = '';
    pintar(0);
    cuenta.textContent = String(resultado.length);
    vacio.classList.toggle('hidden', resultado.length > 0);
    const p = new URLSearchParams();
    if (q.value) p.set('q', q.value);
    if (com.value) p.set('comarca', com.value);
    if (mun.value) p.set('municipio', mun.value);
    if (dis.value) p.set('disciplina', dis.value);
    history.replaceState(null, '', `${location.pathname}${p.toString() ? `?${p}` : ''}`);
    if (medir) {
      clearTimeout(timer);
      timer = setTimeout(() => window.gtag?.('event', 'filtro_directorio', {
        comarca: com.value, municipio: mun.value, disciplina: dis.value, busqueda: q.value.slice(0, 50), resultados: resultado.length,
      }), 800);
    }
  }
  q.addEventListener('input', () => filtrar());
  com.addEventListener('change', () => { rellenarMunicipios(); filtrar(); });
  mun.addEventListener('change', () => filtrar());
  dis.addEventListener('change', () => filtrar());
  mas.addEventListener('click', () => pintar(mostrados));
</script>
