---
import { SITE, ORGANIZATION_SCHEMA, WEBSITE_SCHEMA } from '../data/site';
import CookieConsent from '../components/CookieConsent.astro';
// Inter self-hosted (@fontsource): sin peticiones a Google Fonts — mejor
// rendimiento y sin cesión de IPs a terceros (RGPD post-Schrems II).
//
// Solo los subsets latin y latin-ext: el sitio está en español y catalán, y los
// imports genéricos (`400.css`) arrastraban además cirílico, cirílico extendido,
// griego, griego extendido y vietnamita — 42 archivos woff2 y un CSS de 33 KB
// para siete alfabetos, seis de ellos inútiles aquí (auditoría 2026-08-14).
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-ext-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-ext-700.css';
import '@fontsource/inter/latin-800.css';
import '@fontsource/inter/latin-ext-800.css';
import '@fontsource/inter/latin-900.css';
import '@fontsource/inter/latin-ext-900.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  schema?: object | object[];
  noindex?: boolean;
  /** Idioma de la página. El sitio es en castellano; el catalán es un piloto en /ca/. */
  lang?: 'es' | 'ca';
  /**
   * Rutas equivalentes en cada idioma, si existen. Con esto se emiten los
   * hreflang recíprocos (los dos lados tienen que declararse, o Google los
   * ignora) y x-default apuntando al castellano.
   */
  alternates?: { es: string; ca: string };
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogImage = `${SITE.url}/og-default.png`,
  ogImageAlt = SITE.tagline,
  schema,
  noindex = false,
  lang = 'es',
  alternates,
} = Astro.props;

const canonicalUrl = `${SITE.url}${canonical.endsWith('/') ? canonical : canonical + '/'}`;
const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Analítica Plausible (B1): solo se emite si Pol define PUBLIC_PLAUSIBLE_DOMAIN
// en Vercel (p. ej. "artesmarcialesgarraf.vercel.app"). Plausible no usa
// cookies ni identifica usuarios → no requiere banner de consentimiento (B2);
// la política de privacidad ya recoge este caso condicionalmente.
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {alternates && (
    <>
      <link rel="alternate" hreflang="es" href={`${SITE.url}${alternates.es}`} />
      <link rel="alternate" hreflang="ca" href={`${SITE.url}${alternates.ca}`} />
      <link rel="alternate" hreflang="x-default" href={`${SITE.url}${alternates.es}`} />
    </>
  )}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <!-- Ancho y alto declarados: sin ellos, algunas plataformas descargan la
       imagen antes de decidir el formato de la tarjeta, y otras la degradan a
       miniatura pequeña. -->
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
  <meta property="og:site_name" content={SITE.name} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Geo tags for local SEO -->
  <meta name="geo.region" content="ES-B" />
  <meta name="geo.placename" content="Garraf, Barcelona" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  {plausibleDomain && (
    <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
  )}

  <!-- Schema JSON-LD -->
  {schemaArray.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <!-- Grafo base del sitio: editor + sitio web, con @id estable para que el
       resto de páginas los referencien en lugar de repetirlos. Marca neutra:
       Organization describe la guía como editorial, nunca como gimnasio. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [ORGANIZATION_SCHEMA, WEBSITE_SCHEMA],
  })} />
</head>
<body class="bg-brand-dark text-white font-sans antialiased">
  <slot />
  <CookieConsent />
  <style is:global>
    @media (prefers-reduced-motion: no-preference) {
      html { scroll-behavior: smooth; }
    }
  </style>
</body>
</html>
