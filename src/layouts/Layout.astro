---
import { SITE, ORGANIZATION_SCHEMA, WEBSITE_SCHEMA } from '../lib/site';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';
// Inter self-hosted (@fontsource): sin peticiones a Google Fonts — mejor
// rendimiento y sin cesión de IPs a terceros (RGPD post-Schrems II).
//
// Solo los subsets latin y latin-ext: el sitio está en español y catalán, y los
// imports genéricos (`400.css`) arrastraban además cirílico, cirílico extendido,
// griego, griego extendido y vietnamita — 42 archivos woff2 y un CSS de 33 KB
// para siete alfabetos, seis de ellos inútiles aquí (auditoría 2026-08-14).
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-ext-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-ext-700.css';
import '@fontsource/inter/latin-800.css';
import '@fontsource/inter/latin-ext-800.css';
import '@fontsource/inter/latin-900.css';
import '@fontsource/inter/latin-ext-900.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  schema?: object | object[];
  noindex?: boolean;
  /** Idioma de la página. El sitio es en castellano; el catalán es un piloto en /ca/. */
  lang?: 'es' | 'ca';
  /**
   * Rutas equivalentes en cada idioma, si existen. Con esto se emiten los
   * hreflang recíprocos (los dos lados tienen que declararse, o Google los
   * ignora) y x-default apuntando al castellano.
   */
  alternates?: { es: string; ca: string };
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogImage,
  ogImageAlt = SITE.name,
  schema,
  noindex = false,
  lang = 'es',
  alternates,
} = Astro.props;

// Tarjeta social: la de la página si la trae; si no, la de portada en su idioma.
const og = ogImage ?? `${SITE.url}/og/home-${lang}.jpg`;
const canonicalUrl = `${SITE.url}${canonical.endsWith('/') ? canonical : canonical + '/'}`;
const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {alternates && (
    <>
      <link rel="alternate" hreflang="es" href={`${SITE.url}${alternates.es}`} />
      <link rel="alternate" hreflang="ca" href={`${SITE.url}${alternates.ca}`} />
      <link rel="alternate" hreflang="x-default" href={`${SITE.url}${alternates.es}`} />
    </>
  )}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <!-- Ancho y alto declarados: sin ellos, algunas plataformas descargan la
       imagen antes de decidir el formato de la tarjeta, y otras la degradan a
       miniatura pequeña. -->
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
  <meta property="og:site_name" content={lang === 'ca' ? SITE.nameCa : SITE.name} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Geo tags for local SEO -->
  <meta name="geo.region" content="ES-B" />
  <meta name="geo.placename" content="Catalunya" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />


  <!-- Schema JSON-LD -->
  {schemaArray.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <!-- Grafo base del sitio: editor + sitio web, con @id estable para que el
       resto de páginas los referencien en lugar de repetirlos. Marca neutra:
       Organization describe la guía como editorial, nunca como gimnasio. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [ORGANIZATION_SCHEMA, WEBSITE_SCHEMA],
  })} />
</head>
<body class="bg-brand-dark text-white font-sans antialiased">
  <slot />
  <CookieConsent lang={lang} />
  <script>
    // Eventos de GA4 para las acciones clave. gtag solo existe si hay consentimiento.
    const enviar = (nombre: string, params: Record<string, string> = {}) => (window as any).gtag?.('event', nombre, params);
    document.addEventListener('click', e => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-evento]');
      if (el) enviar(el.dataset.evento!, { centro: el.dataset.centro ?? '', pagina: location.pathname });
    });
    document.querySelectorAll<HTMLDetailsElement>('details[data-evento-abrir]').forEach(d =>
      d.addEventListener('toggle', () => d.open && enviar(d.dataset.eventoAbrir!, { pagina: location.pathname })));
    document.querySelectorAll<HTMLFormElement>('form[role=search]').forEach(f =>
      f.addEventListener('submit', () => enviar('busqueda', { termino: String(new FormData(f).get('q') ?? '').slice(0, 60) })));
  </script>
  <style is:global>
    /* Los filtros ocultan con [hidden]; sin esto, clases como flex o grid lo anulan. */
    [hidden] { display: none !important; }
    /* Listados largos plegados (ListaCentros): «Mostrar más» los despliega. */
    .colapsado .extra { display: none !important; }
    [data-colapsable]:not(.colapsado) > [data-ver-mas] { display: none; }
    /* Enlaces dentro de un párrafo: subrayados, no solo por color (WCAG 1.4.1). */
    main p a:not([class*="bg-"]) { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    @media (prefers-reduced-motion: no-preference) {
      html { scroll-behavior: smooth; }
    }
    /* Cuerpo de texto que entra por set:html (textos editoriales y blog). */
  .articulo { color: #9CA3AF; line-height: 1.75; }
  .articulo h2 {
    color: #fff; font-weight: 800; font-size: 1.5rem; line-height: 1.3;
    margin: 2.25rem 0 1rem;
  }
  .articulo h3 {
    color: #fff; font-weight: 700; font-size: 1.125rem;
    margin: 1.75rem 0 0.75rem;
  }
  .articulo > h2:first-child { margin-top: 0; }
  .articulo p { margin: 0 0 1.1rem; }
  .articulo ul, .articulo ol { margin: 0 0 1.25rem; padding-left: 1.4rem; }
  .articulo ul { list-style: disc; }
  .articulo ol { list-style: decimal; }
  .articulo li { margin-bottom: 0.6rem; }
  .articulo li::marker { color: #DC2626; }
  .articulo strong { color: #E5E7EB; }
  .articulo a { color: #F87171; text-decoration: underline; text-underline-offset: 3px; }
  .articulo a:hover { color: #FCA5A5; }
  .articulo table {
    width: 100%; border-collapse: collapse; margin: 1.5rem 0;
    font-size: 0.875rem; display: block; overflow-x: auto;
  }
  .articulo th, .articulo td {
    border: 1px solid #1F1F1F; padding: 0.6rem 0.8rem; text-align: left;
    vertical-align: top; min-width: 8rem;
  }
  .articulo th:first-child, .articulo td:first-child { min-width: 6rem; }
  .articulo thead th { background: #141414; color: #fff; font-weight: 700; }
  .articulo tbody tr:nth-child(even) { background: #101010; }
  </style>
</body>
</html>
