---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SCHEMA_IDS, whatsappActivo } from '../data/site';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { DISCIPLINES } from '../data/disciplines';
import { LOCATIONS } from '../data/locations';

// Envío por el cliente de correo del visitante (decisión de 2026-08-15: no se
// usa ningún servicio de formularios). El formulario recoge los datos, compone
// un mensaje ya ordenado y lo abre en el programa de correo de quien escribe.
//
// Ventajas: cero dependencias, cero coste, y ningún intermediario llega a tratar
// datos personales — la información va del visitante a nuestro buzón y nada más.
//
// Inconveniente conocido: quien no tenga cliente de correo configurado (habitual
// en móviles con solo webmail) no ve abrirse nada. Por eso, tras enviar, la
// página muestra el mensaje ya redactado con un botón para copiarlo y la
// dirección a la que pegarlo: nadie se queda sin poder escribir.

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${SITE.url}/contacto/`,
  name: 'Contacto | Artes Marciales Garraf',
  description:
    'Cuéntanos qué disciplina te interesa y en qué municipio del Garraf, y te orientamos sin coste sobre cómo empezar.',
  url: `${SITE.url}/contacto/`,
  inLanguage: 'es',
  isPartOf: { '@id': SCHEMA_IDS.website },
  publisher: { '@id': SCHEMA_IDS.organization },
  dateModified: SITE.ultimaRevision,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Contacto', item: `${SITE.url}/contacto/` },
  ],
};

const inputClass =
  'w-full bg-brand-gray border border-brand-border rounded-lg px-4 py-3 text-white text-sm placeholder-brand-muted focus:outline-none focus:border-brand-red transition-colors';
---

<Layout
  title="Contacto | Orientación Gratuita · Artes Marciales Garraf"
  description="¿Quieres empezar a entrenar artes marciales en el Garraf? Cuéntanos qué buscas y te orientamos sin coste. Formulario de contacto y email."
  canonical="/contacto/"
  ogImage={`${SITE.url}/og/contacto.png`}
  ogImageAlt="Ilustración de la guía: símbolo de sobre sobre una trama, canal de orientación"
  schema={[contactSchema, breadcrumbSchema]}
>
  <Header />
  <main id="contenido">

  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <span class="inline-block bg-brand-red/15 text-brand-red text-xs font-semibold px-3 py-1 rounded-full mb-4 uppercase tracking-wider border border-brand-red/30">
          Orientación gratuita
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-white mb-4">Cuéntanos qué buscas</h1>
        <p class="text-brand-muted max-w-lg mx-auto">
          Dinos qué disciplina te interesa, en qué municipio y para quién, y te orientamos sin coste
          sobre cómo empezar. Sin compromiso y sin spam.
        </p>
      </div>

      <img
        src="/img/contacto.webp"
        alt="Ilustración de la guía: símbolo de sobre sobre una trama, canal de orientación"
        width="1600"
        height="400"
        loading="lazy"
        decoding="async"
        class="mb-12 w-full object-cover rounded-2xl border border-brand-border"
      />
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <form id="contact-form" class="space-y-5" data-destino={SITE.email}>
            <div>
              <label for="nombre" class="block text-sm font-medium text-white mb-1.5">Nombre *</label>
              <input type="text" id="nombre" name="nombre" required autocomplete="name"
                class={inputClass} placeholder="Tu nombre" />
            
</div>
            <div>
              <label for="email" class="block text-sm font-medium text-white mb-1.5">Email *</label>
              <input type="email" id="email" name="email" required autocomplete="email"
                class={inputClass} placeholder="tu@email.com" />
            </div>
            <div>
              <label for="telefono" class="block text-sm font-medium text-white mb-1.5">Teléfono (opcional)</label>
              <input type="tel" id="telefono" name="telefono" autocomplete="tel"
                class={inputClass} placeholder="+34 600 000 000" />
            </div>
            <div>
              <label for="disciplina" class="block text-sm font-medium text-white mb-1.5">Disciplina de interés</label>
              <select id="disciplina" name="disciplina" class={inputClass}>
                <option value="">Selecciona una disciplina</option>
                {DISCIPLINES.map(d => <option value={d.nameEs}>{d.nameEs}</option>)}
                <option value="No lo tengo claro">No lo tengo claro</option>
              </select>
            </div>
            <div>
              <label for="municipio" class="block text-sm font-medium text-white mb-1.5">Municipio</label>
              <select id="municipio" name="municipio" class={inputClass}>
                <option value="">Selecciona tu municipio</option>
                {LOCATIONS.map(l => <option value={l.name}>{l.name}</option>)}
                <option value="Otro">Otro</option>
              </select>
            </div>
            <div>
              <label for="mensaje" class="block text-sm font-medium text-white mb-1.5">Mensaje (opcional)</label>
              <textarea id="mensaje" name="mensaje" rows="3" class={`${inputClass} resize-none`}
                placeholder="Cuéntanos tu objetivo, tu edad o la de tu hijo/a, y cualquier duda que tengas"></textarea>
            </div>

            <!-- Consentimiento expreso (RGPD art. 6.1.a): casilla sin marcar por
                 defecto. Aceptar no puede ser un efecto secundario de enviar. -->
            <div class="flex gap-3 items-start">
              <input type="checkbox" id="consentimiento" name="consentimiento" required value="si"
                class="mt-1 w-4 h-4 shrink-0 accent-brand-red" />
              <label for="consentimiento" class="text-xs text-brand-muted leading-relaxed">
                He leído y acepto la <a href="/politica-privacidad/" class="text-brand-red hover:underline">política de privacidad</a>.
                Mis datos se usan solo para responder a esta consulta y no se ceden a ningún centro sin
                mi permiso expreso.
              </label>
            </div>

            <!-- Trampa antispam: los bots rellenan todos los campos, las personas
                 no ven este. Si llega con contenido, el envío se descarta. -->
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

            <button type="submit" id="contact-submit"
              class="w-full bg-brand-red hover:bg-red-700 text-white font-bold py-4 rounded-lg transition-colors text-lg">
              Pedir orientación gratuita →
            </button>

            <p class="text-xs text-brand-muted text-center">
              Al enviar se abre tu programa de correo con el mensaje ya redactado, para que solo
              tengas que darle a enviar. Si no se abre, te lo damos para copiar y pegar.
            </p>
          </form>

          <!-- Resultado del envío. Se muestra sin recargar la página e incluye el
               mensaje redactado: es la red de seguridad para quien no tenga
               cliente de correo y no vería abrirse nada. -->
          <div id="contact-resultado" hidden
            class="bg-brand-gray border border-brand-red/40 rounded-xl p-6 space-y-5">
            <div class="space-y-3">
              <h2 class="text-lg font-bold text-white">Revisa tu programa de correo</h2>
              <p class="text-sm text-brand-muted leading-relaxed">
                Hemos abierto un mensaje dirigido a
                <strong class="text-white">{SITE.email}</strong> con tus datos ya redactados. Solo
                tienes que darle a enviar y te respondemos, normalmente en menos de 48 horas.
              </p>
            </div>

            <div class="border-t border-brand-border pt-5 space-y-3">
              <h3 class="text-sm font-semibold text-white">¿No se ha abierto nada?</h3>
              <p class="text-sm text-brand-muted leading-relaxed">
                Pasa si no tienes un programa de correo configurado. Copia este mensaje y envíalo a
                <a href={`mailto:${SITE.email}`} class="text-brand-red hover:text-red-400">{SITE.email}</a>
                desde donde uses el correo:
              </p>
              <pre id="contact-texto"
                class="bg-brand-dark border border-brand-border rounded-lg p-4 text-xs text-brand-muted whitespace-pre-wrap break-words max-h-56 overflow-y-auto"></pre>
              <button type="button" id="contact-copiar"
                class="w-full bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-lg border border-white/20 transition-colors">
                Copiar el mensaje
              </button>
            </div>

            <p class="text-sm text-brand-muted leading-relaxed border-t border-brand-border pt-5">
              Mientras tanto, échale un ojo al
              <a href="/centros/" class="text-brand-red hover:text-red-400">directorio de centros del Garraf</a>.
            </p>
          </div>
        </div>

        <!-- Contact info -->
        <div class="space-y-8">
          {whatsappActivo && (
            <div>
              <h2 class="text-lg font-bold text-white mb-4">O por WhatsApp, si lo prefieres</h2>
              <div class="bg-brand-gray border border-brand-border rounded-xl p-6">
                <p class="text-sm text-brand-muted mb-4">
                  Es la vía más rápida y no hace falta que rellenes nada: el mensaje se abre ya
                  redactado y solo tienes que enviarlo. {SITE.whatsapp.horario}
                </p>
                <WhatsAppButton variante="primario" class="w-full" />
              </div>
            </div>
          )}

          <div>
            <h2 class="text-lg font-bold text-white mb-4">O escríbenos por email</h2>
            <a href={`mailto:${SITE.email}`}
              class="flex items-center gap-4 bg-brand-gray border border-brand-border rounded-xl p-4 hover:border-brand-red/40 transition-colors group">
              <div class="w-10 h-10 rounded-lg bg-brand-red/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-brand-muted">Email</p>
                <p class="font-semibold text-white group-hover:text-brand-red transition-colors">{SITE.email}</p>
              </div>
            </a>
          </div>

          <div>
            <h2 class="text-lg font-bold text-white mb-4">Qué puedes esperar</h2>
            <div class="bg-brand-gray border border-brand-border rounded-xl p-6 space-y-3">
              {[
                'Te respondemos por email con orientación concreta para tu caso.',
                'Te explicamos qué disciplina encaja con tu objetivo y qué valorar al elegir centro en tu municipio.',
                'No compartimos tus datos con nadie sin tu consentimiento expreso.',
                'No gestionamos altas ni cobramos comisión: la matrícula la haces tú, directamente con el centro.',
              ].map(item => (
                <p class="flex gap-2 text-sm text-brand-muted">
                  <span class="text-brand-red shrink-0">✓</span>
                  {item}
                </p>
              ))}
            </div>
          </div>

          <div>
            <h2 class="text-lg font-bold text-white mb-4">Sobre esta web</h2>
            <div class="bg-brand-gray border border-brand-border rounded-xl p-4">
              <p class="text-sm text-brand-muted leading-relaxed">
                Artes Marciales Garraf es una guía independiente: no somos un gimnasio ni una academia. Nuestro objetivo es ayudarte a empezar a entrenar con información honesta sobre la comarca. <a href="/sobre-nosotros/" class="text-brand-red hover:underline">Más sobre el proyecto →</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const destino = form.dataset.destino!;
    const asunto = 'Solicitud de orientación · Artes Marciales Garraf';
    const panel = document.getElementById('contact-resultado')!;
    const bloqueTexto = document.getElementById('contact-texto')!;
    const botonCopiar = document.getElementById('contact-copiar') as HTMLButtonElement;

    /** Redacta el mensaje con los campos ya ordenados, para que nadie tenga que
     *  escribir de cero ni recordar qué datos hacen falta. */
    const redactar = (datos: FormData) => {
      const campo = (clave: string) => String(datos.get(clave) ?? '').trim();
      return [
        `Nombre: ${campo('nombre')}`,
        `Email: ${campo('email')}`,
        campo('telefono') ? `Teléfono: ${campo('telefono')}` : null,
        campo('disciplina') ? `Disciplina de interés: ${campo('disciplina')}` : null,
        campo('municipio') ? `Municipio: ${campo('municipio')}` : null,
        '',
        campo('mensaje') || '(sin mensaje adicional)',
      ]
        .filter(linea => linea !== null)
        .join('\n');
    };

    form.addEventListener('submit', event => {
      // La validación nativa ya ha pasado aquí, incluida la casilla obligatoria
      // de consentimiento.
      event.preventDefault();

      const datos = new FormData(form);
      const cuerpo = redactar(datos);

      // Honeypot: si viene relleno es un bot. Se corta sin abrir nada y sin
      // decirle por qué.
      if (String(datos.get('_gotcha') ?? '').trim() !== '') {
        form.hidden = true;
        panel.hidden = false;
        return;
      }

      bloqueTexto.textContent = cuerpo;
      form.hidden = true;
      panel.hidden = false;
      panel.scrollIntoView({ block: 'center' });

      // Se abre el cliente de correo después de pintar el panel: si el navegador
      // no tiene ninguno asociado, el visitante ya tiene delante el texto para
      // copiar en lugar de quedarse mirando una página que no reacciona.
      window.location.href =
        `mailto:${destino}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
    });

    botonCopiar.addEventListener('click', async () => {
      const original = botonCopiar.textContent;
      try {
        await navigator.clipboard.writeText(bloqueTexto.textContent ?? '');
        botonCopiar.textContent = 'Mensaje copiado ✓';
      } catch {
        // Sin permiso de portapapeles: se selecciona el texto para que baste
        // con copiar a mano.
        const rango = document.createRange();
        rango.selectNodeContents(bloqueTexto);
        const seleccion = window.getSelection();
        seleccion?.removeAllRanges();
        seleccion?.addRange(rango);
        botonCopiar.textContent = 'Selecciónalo y cópialo';
      }
      setTimeout(() => { botonCopiar.textContent = original; }, 3000);
    });
  }
</script>
