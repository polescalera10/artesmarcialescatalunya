---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import ContactCTA from '../components/ContactCTA.astro';
import CentroCard from '../components/CentroCard.astro';
import LineIcon from '../components/LineIcon.astro';
import { ALL_PAGES, type PageDef } from '../data/pages';
import { getDisciplineBySlug, DISCIPLINES, ALTERNATIVAS, type Discipline } from '../data/disciplines';
import TablaComparativa from '../components/TablaComparativa.astro';
import { getLocationBySlug } from '../data/locations';
import { SITE, SCHEMA_IDS } from '../data/site';
import { LOCATIONS } from '../data/locations';
import { imagenesDe } from '../data/imagenes';
import { blogRelacionado } from '../data/blog-posts';
import {
  getCentros,
  getCentrosCercanos,
  getCentrosByMunicipio,
  getCentrosByDisciplina,
} from '../data/centros';

export async function getStaticPaths() {
  return ALL_PAGES.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props { page: PageDef }
const { page } = Astro.props;

const discipline = page.disciplina ? getDisciplineBySlug(page.disciplina) : null;
const location   = page.municipio  ? getLocationBySlug(page.municipio)   : null;

// Schema honesto: la web es una guía (WebPage/Article), no un negocio local.
// No usar LocalBusiness hasta tener un centro cliente real con NAP verificable.
const pageUrl = `${SITE.url}/${page.slug}/`;
const imagenes = imagenesDe(page, SITE.url);

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": page.type === 'blog' ? 'Article' : 'WebPage',
  "@id": pageUrl,
  "name": page.meta.title,
  "headline": page.h1,
  "description": page.meta.description,
  "url": pageUrl,
  "inLanguage": "es",
  // Referencias por @id al grafo declarado en Layout: un solo sitio, un solo
  // editor, en lugar de decenas de entidades sueltas repetidas página a página.
  "isPartOf": { "@id": SCHEMA_IDS.website },
  "publisher": { "@id": SCHEMA_IDS.organization },
  // Article exige `image` para optar a resultados enriquecidos, y en WebPage
  // ayuda a que las superficies que citan la guía tengan algo que mostrar.
  "image": {
    "@type": "ImageObject",
    "url": imagenes.og,
    "width": 1200,
    "height": 630,
  },
  ...(page.type === 'blog' ? { "author": { "@id": SCHEMA_IDS.organization } } : {}),
  "dateModified": page.fecha ?? SITE.ultimaRevision,
  ...(page.fecha ? { "datePublished": page.fecha } : {}),
  ...(location
    ? {
        "about": {
          "@type": "Place",
          "name": location.name,
          "containedInPlace": {
            "@type": "AdministrativeArea",
            "name": `Comarca del ${location.comarca}`,
            "containedInPlace": { "@type": "AdministrativeArea", "name": location.province },
          },
        },
      }
    : {}),
};

// Migas de pan: se construyen acumulando niveles para que las posiciones sean
// siempre correlativas. Antes, las páginas sin municipio ni disciplina (los
// hubs de perfil) se quedaban con un único nivel y la página actual no
// aparecía, aunque la miga visible sí la mostraba.
const breadcrumbItems: { "@type": string; position: number; name: string; item: string }[] = [];
const pushCrumb = (name: string, item: string) =>
  breadcrumbItems.push({ "@type": "ListItem", position: breadcrumbItems.length + 1, name, item });

pushCrumb('Inicio', `${SITE.url}/`);
if (page.type === 'blog') pushCrumb('Blog', `${SITE.url}/blog/`);
if (location && page.type !== 'hub-municipio') pushCrumb(location.name, `${SITE.url}/${location.slug}/`);
if (discipline && page.type !== 'hub-disciplina' && !location) {
  pushCrumb(discipline.nameEs, `${SITE.url}/${discipline.slug}/`);
}
pushCrumb(discipline && location ? discipline.nameEs : page.h1, pageUrl);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems,
};

// Los hubs son páginas índice, pero su schema no lo decía: describían una
// WebPage suelta sin declarar qué agrupan. Un ItemList con las guías que
// enlazan hace explícita la estructura del sitio.
const guiasDelHub =
  page.type === 'hub-municipio'
    ? ALL_PAGES.filter(p => p.municipio === page.municipio && p.slug !== page.slug)
    : page.type === 'hub-disciplina'
      ? ALL_PAGES.filter(p => p.disciplina === page.disciplina && p.slug !== page.slug)
      : [];

const hubListSchema =
  guiasDelHub.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": `Guías de ${page.h1}`,
        "numberOfItems": guiasDelHub.length,
        "itemListElement": guiasDelHub.map((p, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "url": `${SITE.url}/${p.slug}/`,
          "name": p.h1,
        })),
      }
    : null;

const pageSchemas = [webPageSchema, breadcrumbSchema, ...(hubListSchema ? [hubListSchema] : [])];

// Enlazado interno entre money pages.
//
// Antes se cortaba con `.slice(0, n)` sobre una lista con orden fijo, así que
// las mismas páginas salían enlazadas una y otra vez y las últimas de la lista
// (krav maga, taekwondo) no las enlazaba nadie: la auditoría del 15-08-2026
// las encontró con 3 enlaces internos entrantes frente a los 9-12 de las
// primeras. Rotando la ventana según la posición de la página actual, el
// reparto de enlaces —y por tanto de autoridad interna— se iguala sin añadir
// ni un enlace más por página.
function ventanaRotada<T>(lista: T[], indice: number, n: number): T[] {
  if (lista.length <= n) return lista;
  const desde = ((indice % lista.length) + lista.length) % lista.length;
  return Array.from({ length: n }, (_, i) => lista[(desde + i) % lista.length]);
}

const indicePagina = ALL_PAGES.findIndex(p => p.slug === page.slug);

const relatedByMunicipio = discipline && location
  ? ventanaRotada(
      ALL_PAGES.filter(p => p.municipio === location.slug && p.slug !== page.slug && p.type === 'money-page'),
      indicePagina,
      6,
    )
  : [];
// Ojo con el filtro: hay money pages de la misma disciplina en el MISMO
// municipio (karate-infantil-en-sitges es disciplina karate y municipio
// sitges). Sin excluir el municipio actual se colaban bajo un H2 que dice
// "en otros municipios", y con el ancla generada a partir de disciplina +
// municipio dos páginas distintas recibían la misma ancla ("Karate en
// Sitges" apuntando a la general y a la infantil). El ancla sale ahora del
// H1 real de la página destino, igual que en el módulo de al lado.
const relatedByDisciplina = discipline && location
  ? ventanaRotada(
      ALL_PAGES.filter(
        p =>
          p.disciplina === discipline.slug &&
          p.municipio !== location.slug &&
          p.slug !== page.slug &&
          p.type === 'money-page',
      ),
      indicePagina,
      4,
    )
  : [];

// FAQ genérico honesto (sin horarios, sedes ni ofertas inventadas)
const genericFaq = [
  { q: '¿Necesito experiencia previa para empezar?', a: 'No. Todas las disciplinas tienen niveles de iniciación pensados para empezar desde cero. Lo importante es elegir un grupo adecuado a tu nivel.' },
  { q: '¿Cómo elijo un buen centro?', a: 'Fíjate en la titulación del instructor, en que los grupos estén separados por nivel (y por edad en el caso de los niños) y en que puedas ver o probar una clase antes de comprometerte con una cuota.' },
  { q: '¿Cuánto cuesta entrenar artes marciales?', a: 'Cada centro fija sus tarifas y cambian con el tiempo, por eso no publicamos precios. Pregunta siempre por matrícula, permanencia y clase de prueba antes de apuntarte.' },
  { q: '¿Podéis ayudarme a encontrar clase?', a: 'Sí. Escríbenos por el formulario contándonos qué disciplina te interesa, en qué municipio y para quién, y te orientamos sin coste.' },
];
// Local FAQ first (location-specific), then discipline FAQ or generic fallback
const faqItems = [
  ...(page.localFaq ?? []),
  ...(discipline?.faq ?? genericFaq),
];

// Related disciplines for hub pages
const allDisciplinesForLocation = location
  ? ALL_PAGES.filter(p => p.municipio === location.slug && p.type === 'money-page')
  : [];

// Centros reales del directorio (fuentes públicas verificadas, ver data/centros.ts)
const ordenar = (a: { nombre: string }, b: { nombre: string }) => a.nombre.localeCompare(b.nombre, 'es');
const centrosLocalDisciplina =
  discipline && location ? getCentros(location.slug, discipline.slug).sort(ordenar) : [];
const centrosCercanosDisciplina =
  discipline && location && centrosLocalDisciplina.length === 0
    ? getCentrosCercanos(location.slug, discipline.slug).sort(ordenar)
    : [];
const centrosDeMunicipio =
  page.type === 'hub-municipio' && location ? getCentrosByMunicipio(location.slug).sort(ordenar) : [];
const centrosDeDisciplina =
  page.type === 'hub-disciplina' && discipline ? getCentrosByDisciplina(discipline.slug).sort(ordenar) : [];

// Otros artículos del blog, para interenlazarlos entre sí.
//
// Antes se listaban TODOS los demás artículos: con 35 posts, cada uno llevaba
// 35 enlaces idénticos al pie, y la auditoría del 29-09-2026 encontró los
// artículos con 35-48 enlaces internos entrantes frente a los 7-23 de las
// money pages, que son las que convierten. Ahora van los cuatro más afines:
// los que enlazan a más páginas en común desde el cuerpo (mismos hubs, mismas
// money pages), y a igualdad, los más recientes. El índice /blog/ sigue
// listándolos todos, así que ninguno se queda huérfano.
const MAX_OTROS_ARTICULOS = 4;
const enlacesDelCuerpo = (p: PageDef): Set<string> =>
  new Set([...(p.body ?? '').matchAll(/href="\/([^"#?]+?)\/?"/g)].map(m => m[1]));
const otrosArticulos = (() => {
  if (page.type !== 'blog') return [];
  const propios = enlacesDelCuerpo(page);
  return ALL_PAGES
    .filter(p => p.type === 'blog' && p.slug !== page.slug)
    .map(p => {
      const suyos = enlacesDelCuerpo(p);
      let comunes = 0;
      for (const e of suyos) if (propios.has(e)) comunes++;
      // Un enlace directo entre los dos artículos pesa más que un destino común.
      if (propios.has(p.slug) || suyos.has(page.slug)) comunes += 3;
      return { p, comunes };
    })
    .sort((a, b) => b.comunes - a.comunes || (b.p.fecha ?? '').localeCompare(a.p.fecha ?? ''))
    .slice(0, MAX_OTROS_ARTICULOS)
    .map(x => x.p);
})();

// Artículos del blog que amplían el tema de esta página (disciplina o perfil).
// Enlazarlos desde aquí es lo que saca al blog de sus 5-8 enlaces entrantes.
const articulosDelTema =
  page.type === 'blog'
    ? []
    : blogRelacionado([page.disciplina, page.slug], page.slug)
        .map(slug => ALL_PAGES.find(p => p.slug === slug))
        .filter((p): p is PageDef => Boolean(p));

// ── Anti-duplicación (auditoría 2026-08-14) ─────────────────────────────────
// Los bloques genéricos de la disciplina (beneficios, primera clase, equipación)
// son idénticos en todas las páginas que comparten disciplina, y eran la causa
// principal del solapamiento entre `karate-en-X` y `karate-infantil-en-X`. Las
// páginas que traen cuerpo propio ya aportan ese contenido de forma específica,
// así que en ellas se omiten los bloques de plantilla.
const tieneCuerpoPropio = Boolean(page.body) && page.type !== 'blog';
const mostrarBloquesGenericos = Boolean(discipline) && !tieneCuerpoPropio;

// ── Reparto de contenido entre hub de disciplina y páginas de municipio ─────
// (auditoría 2026-08-15: `/judo/` y `/judo-en-sitges/` compartían el 48 % del
// texto). Cada tipo de página se queda con lo que solo ella puede aportar:
//
//   · hub de disciplina → la comparativa con las otras nueve y la equipación.
//     Es la pregunta "¿me pega a mí el judo?", que no depende del municipio.
//   · página de municipio → cómo es la primera clase, qué centros constan allí
//     y la FAQ local. Es la pregunta "¿dónde y cómo empiezo aquí?".
//
// El bloque de equipación era idéntico en las 4-5 páginas de cada disciplina,
// así que sale de las locales y se queda solo en el hub, enlazado desde ellas.
const esHubDisciplina = page.type === 'hub-disciplina' && Boolean(discipline);
const mostrarEquipacion = mostrarBloquesGenericos && esHubDisciplina;
const mostrarPrimeraClase = mostrarBloquesGenericos && (page.type === 'money-page' || esHubDisciplina);

// Comparativa. La tabla de las diez disciplinas es de `/iniciacion/` y de
// nadie más: repetirla en los diez hubs subía el solapamiento entre ellos del
// 47 % al 53 %. Cada hub muestra su propia disciplina frente a las tres con
// las que realmente se duda, que son distintas en cada caso.
const comparativa: Discipline[] = esHubDisciplina && discipline
  ? [discipline, ...(ALTERNATIVAS[discipline.slug] ?? []).map(s => getDisciplineBySlug(s)).filter((d): d is Discipline => Boolean(d))]
  : page.slug === 'iniciacion'
    ? DISCIPLINES
    : [];

// Páginas de perfil del municipio (niños / mujeres / adultos). Antes no las
// enlazaba nadie: eran huérfanas pese a estar en el sitemap.
const perfilesDelMunicipio = location
  ? ALL_PAGES.filter(
      p =>
        p.municipio === location.slug &&
        p.slug !== page.slug &&
        !p.disciplina &&
        p.type === 'money-page',
    )
  : [];

// En los hubs de perfil comarcales, sus variantes por municipio.
const PERFIL_VARIANTES: Record<string, string[]> = {
  'clases-para-ninos': ['clases-infantiles-en-sitges', 'clases-infantiles-en-vilanova'],
  'clases-para-mujeres': ['clases-para-mujeres-en-sitges', 'clases-para-mujeres-en-vilanova'],
  'clases-para-adultos': ['clases-para-adultos-en-sitges', 'clases-para-adultos-en-vilanova'],
};
const variantesDePerfil =
  page.type === 'hub-perfil'
    ? (PERFIL_VARIANTES[page.slug] ?? [])
        .map(s => ALL_PAGES.find(p => p.slug === s))
        .filter((p): p is PageDef => Boolean(p))
    : [];
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
  canonical={`/${page.slug}/`}
  ogImage={imagenes.og}
  ogImageAlt={imagenes.alt}
  schema={pageSchemas}
>
  <Header />

  <!-- Breadcrumbs -->
  <nav aria-label="Migas de pan" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-0">
    <ol class="flex items-center gap-2 text-xs text-brand-muted">
      <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
      {page.type === 'blog' && (
        <>
          <li class="text-brand-border">/</li>
          <li><a href="/blog/" class="hover:text-white transition-colors">Blog</a></li>
        </>
      )}
      {location && (
        <>
          <li class="text-brand-border">/</li>
          <li><a href={`/${location.slug}/`} class="hover:text-white transition-colors">{location.name}</a></li>
        </>
      )}
      {discipline && (
        <>
          <li class="text-brand-border">/</li>
          <li class="text-white">{discipline.nameEs}</li>
        </>
      )}
      {!discipline && !location && (
        <>
          <li class="text-brand-border">/</li>
          <li class="text-white">{page.h1}</li>
        </>
      )}
    </ol>
  </nav>

  <!-- Hero section -->
  <section class="relative overflow-hidden bg-brand-dark pt-10 pb-16 px-4">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-red/8 via-transparent to-transparent pointer-events-none" />
    <div class="max-w-7xl mx-auto relative">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          {discipline && (
            <span class="inline-flex items-center gap-2 bg-brand-red/15 text-brand-red text-xs font-semibold px-3 py-1 rounded-full mb-4 border border-brand-red/30">
              <LineIcon name={discipline.slug} class="w-4 h-4 shrink-0" />
              <span>{discipline.nameEs} · {location?.name ?? 'Comarca del Garraf'}</span>
            </span>
          )}
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight mb-6">
            {page.h1}
          </h1>
          <p class="text-brand-muted leading-relaxed mb-8 text-lg">
            {page.intro}
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            {SITE.contactoActivo ? (
              <a href="/contacto/" class="bg-brand-red hover:bg-red-700 text-white font-bold px-8 py-3 rounded-lg transition-colors text-center">
                Pedir orientación gratuita
              </a>
            ) : (
              <a href="/centros/" class="bg-brand-red hover:bg-red-700 text-white font-bold px-8 py-3 rounded-lg transition-colors text-center">
                Ver centros del Garraf
              </a>
            )}
            <a href="/iniciacion/" class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-3 rounded-lg border border-white/20 transition-colors">
              ¿Por dónde empiezo?
            </a>
          </div>
        </div>
        <!-- Info card: datos genéricos de la disciplina, sin inventar oferta local -->
        <div class="bg-brand-gray border border-brand-border rounded-2xl p-6 space-y-4">
          <h2 class="font-bold text-white text-lg mb-2">Resumen rápido</h2>
          {[
            { label: 'Zona', value: location?.name ?? 'Comarca del Garraf' },
            ...(discipline ? [
              { label: 'Disciplina', value: discipline.nameEs },
              { label: 'Ideal para', value: discipline.suitable.slice(0, 3).join(' · ') },
            ] : [
              { label: 'Disciplinas', value: 'Boxeo · Karate · MMA · BJJ y más' },
            ]),
            ...(discipline && location ? [
              {
                label: 'Centros en el directorio',
                value: centrosLocalDisciplina.length > 0
                  ? `${centrosLocalDisciplina.length} en ${location.nameShort}`
                  : `${centrosCercanosDisciplina.length} en municipios cercanos`,
              },
            ] : []),
            { label: 'Niveles', value: 'Desde iniciación absoluta' },
            SITE.contactoActivo
              ? { label: 'Orientación', value: '✓ Gratuita vía formulario' }
              : { label: 'Directorio', value: '✓ Con fuente y fecha' },
          ].map(row => (
            <div class="flex justify-between text-sm border-b border-brand-border pb-3 last:border-0 last:pb-0">
              <span class="text-brand-muted">{row.label}</span>
              <span class="text-white font-medium text-right max-w-[55%]">{row.value}</span>
            </div>
          ))}
          <a
            href={SITE.contactoActivo ? '/contacto/' : '/centros/'}
            class="block w-full bg-brand-red hover:bg-red-700 text-white text-center font-bold py-3 rounded-lg transition-colors mt-2"
          >
            {SITE.contactoActivo ? 'Contactar →' : 'Ver el directorio →'}
          </a>
        </div>
      </div>

      <!-- Ilustración de sección. Va después del titular a propósito: no
           empuja el H1 hacia abajo y sirve de separación entre la cabecera y
           el contenido. `width`/`height` explícitos para que no haya salto de
           maquetación (CLS) mientras carga. -->
      {imagenes.hero && (
        <img
          src={imagenes.hero}
          alt={imagenes.alt}
          width="1600"
          height="400"
          loading="lazy"
          decoding="async"
          class="mt-12 w-full object-cover rounded-2xl border border-brand-border"
        />
      )}
    </div>
  </section>

  <!-- Benefits -->
  {mostrarBloquesGenericos && discipline && (
    <section class="py-14 px-4 bg-brand-gray/30">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-8 text-center">
          Qué aporta entrenar {discipline.nameEs}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {discipline.benefits.map((b, i) => (
            <div class="bg-brand-gray border border-brand-border rounded-xl p-5">
              <div class="w-8 h-8 rounded-lg bg-brand-red/20 text-brand-red text-sm font-bold flex items-center justify-center mb-3">
                {i + 1}
              </div>
              <p class="text-sm text-white font-medium">{b}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Cómo es la primera clase + equipación (contenido genérico honesto de la disciplina) -->
  {mostrarPrimeraClase && discipline && (
    <section class="py-14 px-4">
      <div class="max-w-7xl mx-auto">
        <div class:list={['grid gap-8', mostrarEquipacion && 'lg:grid-cols-2']}>
          <div class="bg-brand-gray border border-brand-border rounded-2xl p-6">
            <h2 class="text-xl font-bold text-white mb-2">
              Cómo suele ser una primera clase de {discipline.nameEs}
            </h2>
            <p class="text-xs text-brand-muted mb-5">
              Cada centro tiene su propia dinámica; esto es lo habitual en la disciplina.
            </p>
            <ol class="space-y-3">
              {discipline.primeraClase.map((paso, i) => (
                <li class="flex gap-3 text-sm text-brand-muted leading-relaxed">
                  <span class="w-6 h-6 shrink-0 rounded-full bg-brand-red/20 text-brand-red text-xs font-bold flex items-center justify-center mt-0.5">
                    {i + 1}
                  </span>
                  <span>{paso}</span>
                </li>
              ))}
            </ol>
            {!mostrarEquipacion && (
              <p class="mt-5 pt-4 border-t border-brand-border text-sm text-brand-muted">
                Qué material necesitas y cuánto puedes esperar antes de comprarlo, en la{' '}
                <a href={`/${discipline.slug}/`} class="text-brand-red hover:text-red-400">
                  guía de {discipline.nameEs} del Garraf
                </a>.
              </p>
            )}
          </div>
          {mostrarEquipacion && (
            <div class="bg-brand-gray border border-brand-border rounded-2xl p-6">
              <h2 class="text-xl font-bold text-white mb-2">Equipación para empezar</h2>
              <p class="text-xs text-brand-muted mb-5">
                Sin marcas ni prisas: pregunta siempre en el centro antes de comprar nada.
              </p>
              <ul class="space-y-3">
                {discipline.equipacion.map(item => (
                  <li class="flex gap-3 text-sm text-brand-muted leading-relaxed">
                    <span class="text-brand-red mt-0.5">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Comparativa entre disciplinas. En los hubs, esta disciplina frente a sus
       tres alternativas reales; en /iniciacion/, las diez. -->
  {comparativa.length > 0 && (
    <section class="py-14 px-4 bg-brand-gray/30">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-2">
          {discipline
            ? `${discipline.nameEs} frente a las disciplinas con las que se confunde`
            : 'Las diez disciplinas del Garraf, una al lado de otra'}
        </h2>
        <p class="text-sm text-brand-muted mb-8 max-w-3xl">
          {discipline
            ? `Casi nadie duda entre ${discipline.nameEs} y las nueve restantes: se duda entre tres o cuatro parecidas. Estas son las que de verdad compiten con ella, y en qué se separan.`
            : 'Qué se hace en cada una, cuánto contacto hay de verdad en los grupos de iniciación, desde qué edad suele haber grupo, qué material necesitas y qué papel tiene la competición.'}
        </p>
        <TablaComparativa disciplinas={comparativa} actual={discipline?.slug} />
        <p class="mt-5 text-xs text-brand-muted">
          {discipline ? (
            <>
              ¿Ninguna te convence del todo? La guía de{' '}
              <a href="/iniciacion/" class="text-brand-red hover:text-red-400">iniciación a las artes marciales</a>{' '}
              compara las diez y te lleva a una recomendación según tu objetivo, tu edad y tu carácter.
            </>
          ) : (
            <>
              Cada disciplina tiene su guía con el detalle de la primera clase, la equipación y dónde
              se practica en la comarca. Empieza por el{' '}
              <a href="/centros/" class="text-brand-red hover:text-red-400">directorio de centros</a>{' '}
              si ya lo tienes claro.
            </>
          )}
        </p>
      </div>
    </section>
  )}

  <!-- Money page: centros reales que ofrecen la disciplina en el municipio -->
  {page.type === 'money-page' && discipline && location && (centrosLocalDisciplina.length > 0 || centrosCercanosDisciplina.length > 0) && (
    <section class="py-14 px-4">
      <div class="max-w-7xl mx-auto">
        {centrosLocalDisciplina.length > 0 ? (
          <>
            <h2 class="text-2xl font-bold text-white mb-2">
              Dónde practicar {discipline.nameEs} en {location.name}
            </h2>
            <p class="text-sm text-brand-muted mb-8 max-w-3xl">
              Centros de {location.name} que anuncian {discipline.nameEs} según fuentes públicas verificadas.
              Orden alfabético, sin valoraciones: comprueba horarios y condiciones directamente con cada centro.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              {centrosLocalDisciplina.map(c => <CentroCard centro={c} />)}
            </div>
          </>
        ) : (
          <>
            <h2 class="text-2xl font-bold text-white mb-2">
              {discipline.nameEs} cerca de {location.name}
            </h2>
            <p class="text-sm text-brand-muted mb-8 max-w-3xl">
              En nuestro directorio no consta por ahora ningún centro de {discipline.nameEs} con fuente pública
              verificable en {location.name}. Estas son las opciones más cercanas de la comarca:
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              {centrosCercanosDisciplina.map(c => <CentroCard centro={c} showMunicipio />)}
            </div>
          </>
        )}
        <p class="mt-6 text-xs text-brand-muted">
          Ver el <a href="/centros/" class="text-brand-red hover:text-red-400">directorio completo de centros del Garraf</a>.
          si un dato ha cambiado o falta un centro, <a href="/contacto/" class="text-brand-red hover:text-red-400">avísanos</a>.
        </p>
      </div>
    </section>
  )}

  <!-- Hub municipio: list all disciplines available -->
  {page.type === 'hub-municipio' && location && (
    <section class="py-14 px-4">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-8">
          Guías de disciplinas en {location.name}
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {allDisciplinesForLocation.map(p => {
            const d = getDisciplineBySlug(p.disciplina!);
            return d ? (
              <a
                href={`/${p.slug}/`}
                class="group bg-brand-gray border border-brand-border hover:border-brand-red/50 rounded-xl p-4 text-center transition-all"
              >
                <LineIcon name={d.slug} class="w-8 h-8 text-brand-red mx-auto mb-2" />
                <span class="text-sm font-semibold text-white group-hover:text-brand-red transition-colors">{d.nameEs}</span>
              </a>
            ) : null;
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Hub disciplina: list all locations -->
  {page.type === 'hub-disciplina' && discipline && (
    <section class="py-14 px-4">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-8">
          {discipline.nameEs} por municipios del Garraf
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {LOCATIONS.map(loc => {
            const moneyPage = ALL_PAGES.find(p => p.disciplina === discipline.slug && p.municipio === loc.slug);
            return moneyPage ? (
              <a
                href={`/${moneyPage.slug}/`}
                class="group bg-brand-gray border border-brand-border hover:border-brand-red/40 rounded-xl p-6 transition-all"
              >
                <h3 class="font-bold text-white group-hover:text-brand-red transition-colors mb-1">
                  {discipline.nameEs} en {loc.name}
                </h3>
                <p class="text-sm text-brand-muted">{loc.desc.split('.')[0]}.</p>
                <span class="text-xs text-brand-red mt-3 block">Ver guía →</span>
              </a>
            ) : (
              <div class="bg-brand-gray/50 border border-brand-border rounded-xl p-6">
                <h3 class="font-bold text-white mb-1">{discipline.nameEs} en {loc.name}</h3>
                <p class="text-sm text-brand-muted">Pregúntanos por las opciones en esta zona.</p>
                <a href="/contacto/" class="text-xs text-brand-red mt-3 block">Consultar →</a>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Hub municipio: centros reales del municipio -->
  {page.type === 'hub-municipio' && location && (
    <section class="py-14 px-4 bg-brand-gray/30">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-2">
          Centros de artes marciales en {location.name}
        </h2>
        {centrosDeMunicipio.length > 0 ? (
          <>
            <p class="text-sm text-brand-muted mb-8 max-w-3xl">
              Centros del municipio con presencia pública verificable. Orden alfabético, sin valoraciones.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              {centrosDeMunicipio.map(c => <CentroCard centro={c} />)}
            </div>
          </>
        ) : (
          <p class="text-sm text-brand-muted mb-2 max-w-3xl">
            A fecha de la última verificación no nos consta ningún centro con fuente pública verificable en{' '}
            {location.name}. Los municipios vecinos ({(location.nearbyTowns ?? []).join(', ')}) y el resto de la
            comarca concentran la oferta más cercana.
          </p>
        )}
        <p class="mt-6 text-xs text-brand-muted">
          Ver el <a href="/centros/" class="text-brand-red hover:text-red-400">directorio completo del Garraf</a>.
          ¿falta un centro o hay un dato desactualizado? <a href="/contacto/" class="text-brand-red hover:text-red-400">Escríbenos</a>.
        </p>
      </div>
    </section>
  )}

  <!-- Hub disciplina: centros reales de la comarca que la ofrecen -->
  {page.type === 'hub-disciplina' && discipline && centrosDeDisciplina.length > 0 && (
    <section class="py-14 px-4 bg-brand-gray/30">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-2">
          Dónde se practica {discipline.nameEs} en el Garraf
        </h2>
        <p class="text-sm text-brand-muted mb-8 max-w-3xl">
          Centros de la comarca que anuncian {discipline.nameEs} según fuentes públicas verificadas.
          Orden alfabético, sin valoraciones.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {centrosDeDisciplina.map(c => <CentroCard centro={c} showMunicipio />)}
        </div>
        <p class="mt-6 text-xs text-brand-muted">
          Ver el <a href="/centros/" class="text-brand-red hover:text-red-400">directorio completo del Garraf</a>.
        </p>
      </div>
    </section>
  )}

  <!-- Internal links: otras disciplinas en el mismo municipio -->
  {relatedByMunicipio.length > 0 && (
    <section class="py-12 px-4 bg-brand-gray/30">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-lg font-bold text-white mb-6">
          Más disciplinas en {location?.name}
        </h2>
        <div class="flex flex-wrap gap-3">
          {relatedByMunicipio.map(p => {
            const d = getDisciplineBySlug(p.disciplina!);
            return (
              <a
                href={`/${p.slug}/`}
                class="flex items-center gap-2 bg-brand-gray border border-brand-border hover:border-brand-red/40 rounded-lg px-4 py-2 text-sm text-brand-muted hover:text-white transition-all"
              >
                {d && <LineIcon name={d.slug} class="w-4 h-4 text-brand-red shrink-0" />}
                {p.h1.replace('Clases de ', '')}
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Internal links: misma disciplina en otros municipios -->
  {relatedByDisciplina.length > 0 && (
    <section class="py-10 px-4">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-lg font-bold text-white mb-6">
          {discipline?.nameEs} en otros municipios del Garraf
        </h2>
        <div class="flex flex-wrap gap-3">
          {relatedByDisciplina.map(p => (
            <a
              href={`/${p.slug}/`}
              class="bg-brand-gray border border-brand-border hover:border-brand-red/40 rounded-lg px-4 py-2 text-sm text-brand-muted hover:text-white transition-all"
            >
              {p.h1.replace('Clases de ', '')}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Cuerpo propio de hubs de municipio y páginas de perfil -->
  {tieneCuerpoPropio && (
    <section class="py-12 px-4">
      <article class="max-w-3xl mx-auto articulo" set:html={page.body} />
    </section>
  )}

  <!-- Guías por perfil del municipio (evita que queden huérfanas) -->
  {perfilesDelMunicipio.length > 0 && location && (
    <section class="py-12 px-4">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-2">Guías por perfil en {location.name}</h2>
        <p class="text-sm text-brand-muted mb-8 max-w-3xl">
          Si buscas para alguien concreto (tu hijo, tú misma, tú empezando de cero) estas guías
          entran en el detalle que cambia según el perfil.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {perfilesDelMunicipio.map(p => (
            <a
              href={`/${p.slug}/`}
              class="group bg-brand-gray border border-brand-border hover:border-brand-red/40 rounded-xl p-5 transition-all"
            >
              <span class="font-semibold text-brand-red group-hover:text-red-400 transition-colors">
                {p.h1} →
              </span>
              <p class="text-sm text-brand-muted mt-2 leading-relaxed">{p.meta.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Hub de perfil: sus variantes por municipio -->
  {variantesDePerfil.length > 0 && (
    <section class="py-12 px-4">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-2">La misma guía, por municipio</h2>
        <p class="text-sm text-brand-muted mb-8 max-w-3xl">
          La oferta real cambia mucho de un municipio a otro del Garraf. Estas versiones
          concretan qué consta en cada sitio y qué implica para ti.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {variantesDePerfil.map(p => (
            <a
              href={`/${p.slug}/`}
              class="group bg-brand-gray border border-brand-border hover:border-brand-red/40 rounded-xl p-5 transition-all"
            >
              <span class="font-semibold text-brand-red group-hover:text-red-400 transition-colors">
                {p.h1} →
              </span>
              <p class="text-sm text-brand-muted mt-2 leading-relaxed">{p.meta.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Blog body content -->
  {page.type === 'blog' && page.body && (
    <section class="py-12 px-4">
      <article class="max-w-3xl mx-auto">
        {page.fecha && (
          <p class="text-xs text-brand-muted mb-8">
            Publicado el <time datetime={page.fecha}>{new Date(page.fecha).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
            {' '}· Guía independiente, sin publicidad de centros
          </p>
        )}
        <div class="articulo" set:html={page.body} />
      </article>
    </section>
  )}

  <!-- Guías relacionadas (anti-canibalización: anchors que diferencian la intención) -->
  {page.relacionadas && page.relacionadas.length > 0 && (
    <section class="py-10 px-4">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-lg font-bold text-white mb-6">Guías relacionadas: elige la que encaja con lo que buscas</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {page.relacionadas.map(r => (
            <a
              href={`/${r.slug}/`}
              class="group bg-brand-gray border border-brand-border hover:border-brand-red/40 rounded-xl p-5 transition-all"
            >
              <span class="font-semibold text-brand-red group-hover:text-red-400 transition-colors">{r.label} →</span>
              <p class="text-sm text-brand-muted mt-2 leading-relaxed">{r.nota}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Artículos del blog que amplían el tema de esta página -->
  {articulosDelTema.length > 0 && (
    <section class="py-10 px-4 bg-brand-gray/30">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-lg font-bold text-white mb-6">Para leer con más calma</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {articulosDelTema.map(p => (
            <a
              href={`/${p.slug}/`}
              class="group bg-brand-gray border border-brand-border hover:border-brand-red/40 rounded-xl p-5 transition-all"
            >
              <span class="font-semibold text-brand-red group-hover:text-red-400 transition-colors">{p.h1} →</span>
              <p class="text-sm text-brand-muted mt-2 leading-relaxed">{p.meta.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Otras guías del blog -->
  {otrosArticulos.length > 0 && (
    <section class="py-10 px-4 bg-brand-gray/30">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-lg font-bold text-white mb-6">Sigue leyendo sobre este tema</h2>
        <ul class="space-y-3">
          {otrosArticulos.map(p => (
            <li>
              <a href={`/${p.slug}/`} class="text-brand-red hover:text-red-400 transition-colors font-semibold">
                {p.h1}
              </a>
              <p class="text-sm text-brand-muted mt-0.5">{p.meta.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <FAQ items={faqItems} title={`Preguntas frecuentes sobre ${discipline?.nameEs ?? 'artes marciales'} en ${location?.name ?? 'el Garraf'}`} />
  <ContactCTA disciplina={discipline?.nameEs} municipio={location?.name} />
  <Footer />
</Layout>

<!-- Estilos del cuerpo de artículo: el HTML entra por set:html, así que los
     estilos con ámbito de Astro no lo alcanzan; se acotan con .articulo. -->
<style is:global>
  .articulo { color: #9CA3AF; line-height: 1.75; }
  .articulo h2 {
    color: #fff; font-weight: 800; font-size: 1.5rem; line-height: 1.3;
    margin: 2.25rem 0 1rem;
  }
  .articulo h3 {
    color: #fff; font-weight: 700; font-size: 1.125rem;
    margin: 1.75rem 0 0.75rem;
  }
  .articulo > h2:first-child { margin-top: 0; }
  .articulo p { margin: 0 0 1.1rem; }
  .articulo ul, .articulo ol { margin: 0 0 1.25rem; padding-left: 1.4rem; }
  .articulo ul { list-style: disc; }
  .articulo ol { list-style: decimal; }
  .articulo li { margin-bottom: 0.6rem; }
  .articulo li::marker { color: #DC2626; }
  .articulo strong { color: #E5E7EB; }
  .articulo a { color: #DC2626; text-decoration: underline; text-underline-offset: 3px; }
  .articulo a:hover { color: #F87171; }
  .articulo table {
    width: 100%; border-collapse: collapse; margin: 1.5rem 0;
    font-size: 0.875rem; display: block; overflow-x: auto;
  }
  .articulo th, .articulo td {
    border: 1px solid #1F1F1F; padding: 0.6rem 0.8rem; text-align: left;
    vertical-align: top; min-width: 8rem;
  }
  .articulo th:first-child, .articulo td:first-child { min-width: 6rem; }
  .articulo thead th { background: #141414; color: #fff; font-weight: 700; }
  .articulo tbody tr:nth-child(even) { background: #101010; }
</style>
