---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/i18n';
import { comarcasConCentros } from '../lib/centros';
import { getComarca } from '../lib/geo';
---

<Layout title="Página no encontrada | Artes Marciales Catalunya" description="La página que buscas no existe o ha cambiado de dirección." noindex={true}>
  <Header lang="es" />
  <main id="contenido" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <p class="text-brand-red font-black text-6xl">404</p>
    <h1 class="text-3xl font-black text-white mt-4">Esta página no existe</h1>
    <p class="text-brand-muted mt-3">Puede que haya cambiado de dirección al ampliar el directorio a toda Cataluña. Prueba desde aquí:</p>
    <form action={url.centros('es')} method="get" class="mt-6 flex gap-3" role="search">
      <input name="q" type="search" placeholder="Municipio, disciplina o centro" aria-label="Buscar" class="flex-1 bg-brand-gray border border-brand-border rounded-lg px-4 py-3 text-white placeholder-brand-muted focus:outline-none focus:border-brand-red" />
      <button class="bg-brand-red hover:bg-red-700 text-white font-semibold px-5 py-3 rounded-lg">Buscar</button>
    </form>
    <ul class="flex flex-wrap gap-2 mt-8">
      {comarcasConCentros().map(c => <li><a href={url.comarca('es', c)} class="inline-block bg-brand-gray border border-brand-border rounded-lg px-3 py-1.5 text-sm text-brand-muted hover:text-white">{getComarca(c)!.nombre}</a></li>)}
    </ul>
  </main>
  <Footer lang="es" />
</Layout>
