---
import Layout from '../../layouts/Layout.astro';
import CaHeader from '../../components/CaHeader.astro';
import CaFooter from '../../components/CaFooter.astro';
import CentroCardCa from '../../components/CentroCardCa.astro';
import { LOCATIONS } from '../../data/locations';
import { CENTROS, getCentrosByMunicipio } from '../../data/centros';
import { DISCIPLINES } from '../../data/disciplines';
import { DISCIPLINES_CA, rutaCa } from '../../data/ca';
import { SITE, SCHEMA_IDS } from '../../data/site';

// Equivalent en català de /centros/. El recompte surt de centros.ts.
const total = CENTROS.length;
const title = `Arts Marcials al Garraf: Directori de ${total} Centres`;
const description =
  "Directori dels centres reals d'arts marcials del Garraf, amb la font pública de cada fitxa i la data de verificació. Sense valoracions, per municipi.";

const perDisciplina = DISCIPLINES.map(d => ({
  nom: DISCIPLINES_CA[d.slug] ?? d.nameEs,
  municipis: [...new Set(CENTROS.filter(c => c.disciplinas.includes(d.slug)).map(c => LOCATIONS.find(l => l.slug === c.municipio)?.name))],
  n: CENTROS.filter(c => c.disciplinas.includes(d.slug)).length,
}));

const url = `${SITE.url}/ca/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': url,
  name: title,
  description,
  url,
  inLanguage: 'ca',
  isPartOf: { '@id': SCHEMA_IDS.website },
  publisher: { '@id': SCHEMA_IDS.organization },
  dateModified: SITE.ultimaRevision,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: LOCATIONS.length,
    itemListElement: LOCATIONS.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}${rutaCa(l.slug)}`,
      name: `Arts marcials a ${l.name}`,
    })),
  },
};
---

<Layout
  title={title}
  description={description}
  canonical="/ca/"
  ogImage={`${SITE.url}/og/centros.png`}
  ogImageAlt="Directori de centres d'arts marcials del Garraf"
  schema={schema}
  lang="ca"
  alternates={{ es: '/centros/', ca: '/ca/' }}
>
  <CaHeader castella="/centros/" />
  <main id="contingut">
    <section class="max-w-5xl mx-auto px-4 pt-10 pb-6">
      <h1 class="text-3xl sm:text-4xl font-black text-white mb-4">Arts marcials al Garraf: directori de centres</h1>
      <p class="text-lg text-brand-muted leading-relaxed">
        Els {total} centres d'arts marcials dels sis municipis del Garraf que hem pogut verificar amb una font pública: web oficial, registre de federació o directori municipal d'entitats. De cada un, què anuncia i quan ho vam comprovar. Sense valoracions ni rànquings, per ordre alfabètic.
      </p>
      <p class="text-sm text-brand-muted mt-3">
        Aquesta és una guia independent: no som un gimnàs ni una acadèmia. Si algun dia un centre hi té relació comercial, es declara a la seva fitxa.
      </p>
    </section>

    <section class="max-w-5xl mx-auto px-4 py-6">
      <h2 class="text-xl font-bold text-white mb-4">Quina disciplina hi ha a cada municipi</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="text-white border-b border-brand-border">
            <tr><th class="py-2 pr-4">Disciplina</th><th class="py-2 pr-4">Centres</th><th class="py-2">On</th></tr>
          </thead>
          <tbody class="text-brand-muted">
            {perDisciplina.map(d => (
              <tr class="border-b border-brand-border/50">
                <td class="py-2 pr-4 capitalize">{d.nom}</td>
                <td class="py-2 pr-4">{d.n}</td>
                <td class="py-2">{d.n > 0 ? d.municipis.join(', ') : 'Cap centre verificat al Garraf'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {LOCATIONS.map(l => {
      const centres = getCentrosByMunicipio(l.slug).sort((a, b) => a.nombre.localeCompare(b.nombre, 'ca'));
      return (
        <section class="max-w-5xl mx-auto px-4 py-8" id={l.slug}>
          <div class="flex items-baseline justify-between gap-4 mb-4">
            <h2 class="text-xl font-bold text-white">{l.name} <span class="text-brand-muted font-normal">({centres.length})</span></h2>
            <a href={rutaCa(l.slug)} class="text-sm text-brand-red hover:text-red-400 shrink-0">Guia de {l.name} →</a>
          </div>
          {centres.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              {centres.map(c => <CentroCardCa centro={c} />)}
            </div>
          ) : (
            <p class="text-brand-muted">No hi consta cap centre a data de l'última verificació.</p>
          )}
        </section>
      );
    })}
  </main>
  <CaFooter />
</Layout>
