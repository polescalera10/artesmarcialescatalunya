---
import Layout from '../../layouts/Layout.astro';
import CaHeader from '../../components/CaHeader.astro';
import CaFooter from '../../components/CaFooter.astro';
import CentroCardCa from '../../components/CentroCardCa.astro';
import { LOCATIONS } from '../../data/locations';
import { getCentrosByMunicipio } from '../../data/centros';
import { MUNICIPIS_CA, DISCIPLINES_CA, rutaCa } from '../../data/ca';
import { SITE, SCHEMA_IDS } from '../../data/site';
import { conDatos } from '../../data/recuentos';

export function getStaticPaths() {
  return LOCATIONS.filter(l => MUNICIPIS_CA[l.slug]).map(l => ({
    params: { slug: `arts-marcials-${l.slug}` },
    props: { municipio: l.slug },
  }));
}

const { municipio } = Astro.props;
const loc = LOCATIONS.find(l => l.slug === municipio)!;
const text = { intro: conDatos(MUNICIPIS_CA[municipio].intro, 'ca'), cos: conDatos(MUNICIPIS_CA[municipio].cos, 'ca') };
const centres = getCentrosByMunicipio(municipio).sort((a, b) => a.nombre.localeCompare(b.nombre, 'ca'));
const n = centres.length;

// Disciplines del municipi, de més a menys centres: van a la descripció perquè
// és el que es busca ("taekwondo sant pere de ribes").
const compte = new Map<string, number>();
for (const c of centres) for (const d of c.disciplinas) compte.set(d, (compte.get(d) ?? 0) + 1);
const disciplines = [...compte.entries()].sort((a, b) => b[1] - a[1]).map(([s]) => DISCIPLINES_CA[s] ?? s);
const llista = (xs: string[]) => (xs.length <= 1 ? xs.join('') : `${xs.slice(0, -1).join(', ')} i ${xs[xs.length - 1]}`);

const title = n > 0
  ? `Arts Marcials a ${loc.name}: ${n} ${n === 1 ? 'centre' : 'centres'} | Garraf`
  : `Arts Marcials a ${loc.name} | On Entrenar a Prop`;
const description = n > 0
  ? [3, 2, 1]
      .map(k => {
        const curtes = disciplines.map(d => d.replace('arts marcials mixtes (MMA)', 'MMA'));
        const text = curtes.length > k ? `${curtes.slice(0, k).join(', ')} i més` : llista(curtes.slice(0, k));
        return `${n} ${n === 1 ? 'centre' : 'centres'} d'arts marcials a ${loc.name} amb font pública: ${text}. ${n === 1 ? 'Què se\'n sap' : 'Què ofereix cada un'} i què tens a prop.`;
      })
      .find(d => d.length <= 155) ?? `Arts marcials a ${loc.name}: centres amb font pública i què tens a prop.`
  : `Cap centre d'arts marcials de ${loc.name} consta amb font pública verificable. On entrenar a prop i quines disciplines hi ha al Garraf.`;

const url = `${SITE.url}${rutaCa(municipio)}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': url,
    name: title,
    description,
    url,
    inLanguage: 'ca',
    isPartOf: { '@id': SCHEMA_IDS.website },
    publisher: { '@id': SCHEMA_IDS.organization },
    dateModified: SITE.ultimaRevision,
    about: { '@type': 'Place', name: loc.name, containedInPlace: { '@type': 'AdministrativeArea', name: 'Comarca del Garraf' } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Directori', item: `${SITE.url}/ca/` },
      { '@type': 'ListItem', position: 2, name: loc.name, item: url },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  canonical={rutaCa(municipio)}
  ogImage={`${SITE.url}/og/${municipio}.png`}
  ogImageAlt={`Arts marcials a ${loc.name}`}
  schema={schema}
  lang="ca"
  alternates={{ es: `/${municipio}/`, ca: rutaCa(municipio) }}
>
  <CaHeader castella={`/${municipio}/`} />
  <main id="contingut">
    <section class="max-w-4xl mx-auto px-4 pt-10 pb-6">
      <nav aria-label="Molles de pa" class="text-xs text-brand-muted mb-4">
        <a href="/ca/" class="hover:text-white">Directori</a> / <span>{loc.name}</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-black text-white mb-4">Arts marcials a {loc.name}</h1>
      <p class="text-lg text-brand-muted leading-relaxed">{text.intro}</p>
    </section>

    <section class="max-w-4xl mx-auto px-4 py-6 articulo-ca" set:html={text.cos} />

    <section class="max-w-4xl mx-auto px-4 py-8">
      <h2 class="text-xl font-bold text-white mb-4">
        {n > 0 ? `Centres de ${loc.name} al directori (${n})` : `Centres de ${loc.name} al directori`}
      </h2>
      {n > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {centres.map(c => <CentroCardCa centro={c} />)}
        </div>
      ) : (
        <p class="text-brand-muted">Cap a data de l'última verificació. Si en coneixes algun, <a href="/contacto/" lang="es" class="text-brand-red underline">digues-nos-ho</a> i el verifiquem.</p>
      )}
      <p class="text-sm text-brand-muted mt-6">
        Només hi publiquem centres amb una font pública (web oficial, federació o directori municipal), amb la data en què els vam comprovar. Sense valoracions ni rànquings, per ordre alfabètic.
      </p>
    </section>

    <section class="max-w-4xl mx-auto px-4 py-8">
      <div class="bg-brand-gray border border-brand-border rounded-xl p-6">
        <h2 class="text-lg font-bold text-white mb-2">Vols més detall?</h2>
        <p class="text-brand-muted text-sm leading-relaxed">
          La <a href={`/${municipio}/`} lang="es" class="text-brand-red underline">guia completa de {loc.name}</a> (en castellà) inclou cada disciplina, preguntes freqüents i què preguntar abans d'apuntar-te. El <a href="/ca/" class="text-brand-red underline">directori de tot el Garraf</a> té les fitxes dels sis municipis.
        </p>
      </div>
    </section>
  </main>
  <CaFooter />
</Layout>

<style is:global>
  .articulo-ca { color: #9CA3AF; line-height: 1.75; }
  .articulo-ca h2 { color: #fff; font-weight: 800; font-size: 1.4rem; margin: 1.75rem 0 0.9rem; }
  .articulo-ca > h2:first-child { margin-top: 0; }
  .articulo-ca p { margin: 0 0 1.1rem; }
  .articulo-ca a { color: #EF4444; text-decoration: underline; }
</style>
