---
import { L, url, type Lang } from '../lib/i18n';
interface Props { lang: Lang; ambito?: string }
const { lang, ambito } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="bg-brand-gray border border-brand-border rounded-2xl p-6 sm:p-8 grid md:grid-cols-3 gap-6 items-center">
    <div class="md:col-span-2">
      <h2 class="text-xl font-bold text-white">
        {ambito
          ? L(lang, `¿Tienes un centro de artes marciales en ${ambito}?`, `Tens un centre d'arts marcials a ${ambito}?`)
          : L(lang, '¿Tienes un centro de artes marciales?', "Tens un centre d'arts marcials?")}
      </h2>
      <p class="text-sm text-brand-muted mt-2 leading-relaxed">
        {L(lang,
          'Si no apareces, te añadimos gratis. Si tu ficha tiene algún dato mal, la corregimos. Y si quieres destacar o todavía no tienes web, te contamos cómo te podemos ayudar.',
          "Si no hi surts, t'afegim gratis. Si la teva fitxa té alguna dada malament, la corregim. I si vols destacar o encara no tens web, t'expliquem com et podem ajudar.")}
      </p>
    </div>
    <a href={url.paraCentros(lang)} class="text-center bg-brand-red hover:bg-red-700 text-white font-semibold px-5 py-3 rounded-lg transition-colors">
      {L(lang, 'Información para centros', 'Informació per a centres')}
    </a>
  </div>
</section>
