---
// Hasta `max` (3 por defecto) guías del blog que ayudan a decidir en esa página: primero la de
// niños de la comarca (si existe), luego las de la disciplina y, de relleno,
// las generales. En catalán solo salen las que están traducidas.
// Un slug que no exista rompe el build (mejor que un enlace roto).
import { url, type Lang } from '../lib/i18n';
import { articulos, articulosCa, guiasDeDisciplina } from '../lib/blog';

interface Props {
  lang: Lang;
  disciplinas?: string[];
  comarca?: string;
  /** Página orientada a niños: prioriza las guías infantiles */
  infantil?: boolean;
  titulo?: string;
  /** Cuántas guías mostrar como máximo */
  max?: number;
}
const { lang, disciplinas = [], comarca, infantil = false, titulo = lang === 'ca' ? 'Guies per decidir' : 'Guías para decidir', max = 3 } = Astro.props;
// Guías de cada disciplina, ordenadas por lo que tratan de ella (deducido del contenido, no de una lista a mano)
const porDisc = await Promise.all(disciplinas.map(d => guiasDeDisciplina(d, lang, 6)));
const intercaladas = Array.from({ length: 6 }, (_, i) => porDisc.map(l => l[i]).filter(Boolean)).flat();

const NINOS_COMARCA: Record<string, string> = {
  barcelones: 'artes-marciales-para-ninos-en-barcelona',
  'baix-llobregat': 'artes-marciales-para-ninos-en-el-baix-llobregat',
  'valles-occidental': 'artes-marciales-para-ninos-en-el-valles-occidental',
  'valles-oriental': 'artes-marciales-para-ninos-en-el-valles-oriental',
};
const GENERALES = infantil
  ? ['mejor-arte-marcial-para-ninos', 'a-que-edad-empezar-artes-marciales', 'clase-de-prueba-que-preguntar']
  : ['clase-de-prueba-que-preguntar', 'como-elegir-centro-artes-marciales', 'artes-marciales-adultos-principiantes'];

const candidatos = [...new Set([
  ...(comarca && NINOS_COMARCA[comarca] && (infantil || !disciplinas.length) ? [NINOS_COMARCA[comarca]] : []),
  ...intercaladas,
  ...GENERALES,
])];

const todos = await articulos();
for (const s of candidatos) if (!todos.some(x => x.slug === s)) throw new Error(`GuiasRelacionadas: no existe el artículo ${s}`);
const ca = lang === 'ca' ? new Map((await articulosCa()).map(a => [a.original, a])) : null;
const guias = (ca ? candidatos.filter(s => ca.has(s)).map(s => ca.get(s)!) : candidatos.map(s => todos.find(x => x.slug === s)!)).slice(0, max);
---

{guias.length > 0 && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <h2 class="text-lg font-bold text-white mb-3">{titulo}</h2>
    <ul class="grid md:grid-cols-3 gap-4">
      {guias.map(g => (
        <li>
          <a href={url.post(g.slug, lang)} class="block h-full bg-brand-gray border border-brand-border rounded-xl p-4 hover:border-brand-red/40 transition-colors">
            <span class="block font-semibold text-white leading-snug">{g.titulo}</span>
            <span class="block text-sm text-brand-muted mt-1.5 line-clamp-2">{g.descripcion}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
