---
import { L, url, type Lang } from '../lib/i18n';
import { SITE } from '../lib/site';
import { CENTROS, comarcasConCentros, verificados } from '../lib/centros';
// Recuento público: solo centros con actividad verificada (no los del registro).
const NV = verificados(CENTROS).length;

interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-brand-gray border-t border-brand-border mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div class="md:col-span-2">
      <p class="font-bold text-white">{L(lang, SITE.name, SITE.nameCa)}</p>
      <p class="text-sm text-brand-muted mt-2 max-w-md leading-relaxed">
        {L(lang,
          `Directorio independiente de ${NV} centros de artes marciales en ${comarcasConCentros().length} comarcas de Cataluña. Cada ficha lleva su fuente pública y la fecha en que se verificó. No somos un gimnasio ni cobramos por aparecer en el listado.`,
          `Directori independent de ${NV} centres d'arts marcials a ${comarcasConCentros().length} comarques de Catalunya. Cada fitxa porta la font pública i la data en què es va verificar. No som un gimnàs ni cobrem per aparèixer al llistat.`)}
      </p>
    </div>
    <ul class="space-y-1 text-sm">
      <li><a href={url.centros(lang)} class="inline-block py-1 text-brand-muted hover:text-white">{L(lang, 'Todos los centros', 'Tots els centres')}</a></li>
      <li><a href={url.disciplinas(lang)} class="inline-block py-1 text-brand-muted hover:text-white">{L(lang, 'Disciplinas', 'Disciplines')}</a></li>
      <li><a href={url.blog(lang)} class="inline-block py-1 text-brand-muted hover:text-white">Blog</a></li>
      <li><a href={url.sobre(lang)} class="inline-block py-1 text-brand-muted hover:text-white">{L(lang, 'Cómo verificamos', 'Com verifiquem')}</a></li>
    </ul>
    <ul class="space-y-1 text-sm">
      <li><a href={url.paraCentros(lang)} class="inline-block py-1 text-brand-redtext hover:text-red-400 font-semibold">{L(lang, '¿Tienes un centro? →', 'Tens un centre? →')}</a></li>
      <li><a href={url.contacto(lang)} class="inline-block py-1 text-brand-muted hover:text-white">{L(lang, 'Contacto', 'Contacte')}</a></li>
      <li><a href={`mailto:${SITE.email}`} class="inline-block py-1 text-brand-muted hover:text-white">{SITE.email}</a></li>
    </ul>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 border-t border-brand-border flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-xs text-brand-muted">© {year} {L(lang, SITE.name, SITE.nameCa)}</p>
    <div class="flex flex-wrap justify-center gap-x-5 gap-y-1">
      <a href={url.avisoLegal()} class="inline-block py-2 text-xs text-brand-muted hover:text-white">{L(lang, 'Aviso legal', 'Avís legal')}</a>
      <a href={url.privacidad()} class="inline-block py-2 text-xs text-brand-muted hover:text-white">{L(lang, 'Privacidad', 'Privadesa')}</a>
      <button type="button" id="abrir-preferencias-cookies" class="inline-block py-2 text-xs text-brand-muted hover:text-white">Cookies</button>
      <a href="/sitemap.xml" class="inline-block py-2 text-xs text-brand-muted hover:text-white">Sitemap</a>
    </div>
  </div>
</footer>
