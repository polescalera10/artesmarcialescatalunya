---
import { L, url, type Lang } from '../lib/i18n';
import { esPromocionado, esVerificado, type Centro } from '../lib/centros';
import { nombreDisciplina } from '../lib/disciplinas';
import { getMunicipio } from '../lib/geo';

interface Props {
  centro: Centro;
  lang: Lang;
  /** Mostrar municipio (fuera de la página del propio municipio). */
  conMunicipio?: boolean;
  /** Distancia orientativa en km, para listados de "cercanos". */
  km?: number;
}
const { centro: c, lang, conMunicipio = true, km } = Astro.props;
const promo = esPromocionado(c.slug);
const m = getMunicipio(c.municipio)!;
---

<article data-d={c.disciplinas.join(' ')} data-slug={c.slug} data-v={esVerificado(c) ? '1' : '0'} data-inf={c.infantil ? '1' : undefined} class:list={[
  'bg-brand-gray border rounded-xl p-5 flex flex-col gap-3 transition-colors',
  promo ? 'border-amber-500/50' : 'border-brand-border hover:border-brand-red/40',
]}>
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="font-bold text-white leading-snug">
        <a href={url.centro(lang, c.slug)} class="hover:text-brand-red transition-colors">{c.nombre}</a>
      </h3>
      {conMunicipio && (
        <p class="text-xs text-brand-muted mt-0.5">
          {m.nombre}{km !== undefined && <span> · {L(lang, `a unos ${Math.round(km)} km`, `a uns ${Math.round(km)} km`)}</span>}
        </p>
      )}
    </div>
    {!esVerificado(c) && (
      <span class="shrink-0 text-[10px] uppercase tracking-wide text-brand-muted border border-brand-border rounded px-1.5 py-0.5" title={L(lang, 'Inscrito en el registro de la Generalitat; actividad sin confirmar', 'Inscrit al registre de la Generalitat; activitat sense confirmar')}>
        {L(lang, 'Sin verificar', 'Sense verificar')}
      </span>
    )}
    {promo && (
      <span class="shrink-0 text-[10px] uppercase tracking-wide font-semibold text-amber-400 border border-amber-500/40 rounded px-1.5 py-0.5" title={L(lang, 'Este centro paga por aparecer destacado', 'Aquest centre paga per aparèixer destacat')}>
        {L(lang, 'Promocionado', 'Promocionat')}
      </span>
    )}
  </div>

  {c.disciplinas.length > 0 && (
    <ul class="flex flex-wrap gap-1.5">
      {c.disciplinas.map(d => (
        <li class="bg-brand-dark border border-brand-border rounded-full px-2.5 py-0.5 text-xs text-brand-muted">{nombreDisciplina(d, lang)}</li>
      ))}
    </ul>
  )}

  {c.infantil && <p class="text-xs text-sky-300">{L(lang, 'Anuncia clases para niños', 'Anuncia classes per a infants')}</p>}

  {c.direccion && <p class="text-xs text-brand-muted">{c.direccion}</p>}

  <div class="mt-auto pt-2 border-t border-brand-border flex items-center justify-between gap-2 text-xs">
    <a href={url.centro(lang, c.slug)} class="font-semibold text-brand-red hover:text-red-400">{L(lang, 'Ver ficha', 'Veure fitxa')} →</a>
    {c.web ? (
      <a href={c.web} target="_blank" rel={promo ? 'sponsored noopener' : 'noopener'} class="text-brand-muted hover:text-white" data-evento="clic_web_centro" data-centro={c.slug}>{L(lang, 'Web del centro', 'Web del centre')} ↗</a>
    ) : (
      <span class="text-brand-muted/70">{L(lang, 'Sin web conocida', 'Sense web coneguda')}</span>
    )}
  </div>
</article>
