---
import { L, url, type Lang } from '../lib/i18n';
import { comarcasConCentros } from '../lib/centros';
import { getComarca } from '../lib/geo';
import { DISCIPLINAS } from '../lib/disciplinas';
import { rutasDisciplina } from '../lib/rutas';

interface Props {
  lang: Lang;
  /** Ruta equivalente en el otro idioma, si existe. */
  alt?: string;
}
const { lang, alt } = Astro.props;
const otro: Lang = lang === 'es' ? 'ca' : 'es';
const hrefOtro = alt ?? url.home(otro);
const actual = Astro.url.pathname;

const comarcas = comarcasConCentros().map(slug => ({ slug, nombre: getComarca(slug)!.nombre }));
const conPagina = new Set(rutasDisciplina().map(r => r.disciplina));
const disciplinas = DISCIPLINAS.filter(d => conPagina.has(d.slug));

const link = 'px-3 py-2 text-sm rounded-md transition-colors';
const idle = 'text-brand-muted hover:text-white hover:bg-brand-gray/60';
const activo = 'text-white bg-brand-gray';
const empieza = (p: string) => actual.startsWith(p);
---

<a
  href="#contenido"
  class="sr-only focus:not-sr-only focus:absolute focus:z-60 focus:top-2 focus:left-2 focus:bg-brand-red focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:text-sm focus:font-semibold"
>{L(lang, 'Saltar al contenido', 'Salta al contingut')}</a>

<header class="sticky top-0 z-50 bg-brand-dark/95 backdrop-blur-sm border-b border-brand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-3">
      <a href={url.home(lang)} class="flex items-center gap-2 shrink-0">
        <span class="text-brand-redtext font-black text-xl tracking-tight" aria-hidden="true">AM</span>
        <span class="font-bold text-white text-sm leading-tight">
          {L(lang, 'Artes Marciales', 'Arts Marcials')} <span class="text-brand-redtext">Catalunya</span><br />
          <span class="text-brand-muted font-normal hidden sm:inline">{L(lang, 'El directorio verificado', 'El directori verificat')}</span>
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label={L(lang, 'Navegación principal', 'Navegació principal')}>
        <a href={url.centros(lang)} class:list={[link, empieza(url.centros(lang)) ? activo : idle]}>{L(lang, 'Centros', 'Centres')}</a>

        <div class="relative" data-dropdown>
          <button type="button" class:list={[link, idle, 'inline-flex items-center gap-1']} aria-expanded="false" aria-haspopup="true" data-dropdown-toggle>
            {L(lang, 'Comarcas', 'Comarques')}
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="hidden absolute left-0 top-full mt-1 w-[560px] max-h-[70vh] overflow-y-auto bg-brand-gray border border-brand-border rounded-xl shadow-xl shadow-black/40 p-2 grid grid-cols-3 gap-0.5" data-dropdown-panel>
            {comarcas.map(c => (
              <a href={url.comarca(lang, c.slug)} class="px-3 py-1.5 rounded-lg text-sm text-brand-muted hover:text-white hover:bg-brand-border/60">{c.nombre}</a>
            ))}
          </div>
        </div>

        <div class="relative" data-dropdown>
          <button type="button" class:list={[link, idle, 'inline-flex items-center gap-1']} aria-expanded="false" aria-haspopup="true" data-dropdown-toggle>
            {L(lang, 'Disciplinas', 'Disciplines')}
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="hidden absolute left-0 top-full mt-1 w-[440px] bg-brand-gray border border-brand-border rounded-xl shadow-xl shadow-black/40 p-2 grid grid-cols-2 gap-0.5" data-dropdown-panel>
            {disciplinas.map(d => (
              <a href={url.disciplina(lang, d.slug)} class="px-3 py-1.5 rounded-lg text-sm text-brand-muted hover:text-white hover:bg-brand-border/60">{d[lang]}</a>
            ))}
          </div>
        </div>

        <a href={url.blog(lang)} class:list={[link, empieza(url.blog(lang)) ? activo : idle]}>Blog</a>
        <a href={hrefOtro} hreflang={otro} lang={otro} class:list={[link, idle, 'uppercase text-xs tracking-wide']}>{otro}</a>
        <a href={url.paraCentros(lang)} class="ml-2 bg-brand-red hover:bg-red-700 text-white text-sm font-semibold px-4 py-2 rounded-md transition-colors">
          {L(lang, 'Para centros', 'Per a centres')}
        </a>
      </nav>

      <details class="lg:hidden relative">
        <summary class="list-none cursor-pointer p-2 text-white" aria-label={L(lang, 'Abrir menú', 'Obre el menú')}>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </summary>
        <nav class="absolute right-0 top-full mt-2 w-72 max-h-[80vh] overflow-y-auto bg-brand-gray border border-brand-border rounded-xl p-4 flex flex-col gap-4" aria-label={L(lang, 'Navegación móvil', 'Navegació mòbil')}>
          <a href={url.centros(lang)} class="text-white font-semibold">{L(lang, 'Todos los centros', 'Tots els centres')}</a>
          <a href={url.disciplinas(lang)} class="text-white font-semibold">{L(lang, 'Disciplinas', 'Disciplines')}</a>
          <div>
            <p class="text-xs uppercase tracking-wide text-brand-muted mb-2">{L(lang, 'Comarcas', 'Comarques')}</p>
            <div class="grid grid-cols-2 gap-1">
              {comarcas.map(c => <a href={url.comarca(lang, c.slug)} class="text-sm text-brand-muted hover:text-white">{c.nombre}</a>)}
            </div>
          </div>
          <a href={url.blog(lang)} class="text-white font-semibold">Blog</a>
          <a href={url.paraCentros(lang)} class="bg-brand-red text-white text-center font-semibold px-4 py-2 rounded-md">{L(lang, 'Para centros', 'Per a centres')}</a>
          <a href={hrefOtro} hreflang={otro} lang={otro} class="text-sm text-brand-muted">{otro === 'ca' ? 'Català' : 'Castellano'}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach(dd => {
    const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]')!;
    const panel = dd.querySelector<HTMLElement>('[data-dropdown-panel]')!;
    const cerrar = () => { panel.classList.add('hidden'); btn.setAttribute('aria-expanded', 'false'); };
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const abierto = !panel.classList.contains('hidden');
      document.querySelectorAll('[data-dropdown-panel]').forEach(p => p.classList.add('hidden'));
      if (!abierto) { panel.classList.remove('hidden'); btn.setAttribute('aria-expanded', 'true'); }
    });
    document.addEventListener('click', cerrar);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrar(); });
  });
</script>
