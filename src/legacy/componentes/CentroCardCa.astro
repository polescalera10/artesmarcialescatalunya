---
import type { Centro } from '../data/centros';
import { DISCIPLINES_CA, FUENTE_LABELS_CA } from '../data/ca';

interface Props { centro: Centro }
const { centro: c } = Astro.props;
const data = new Date(`${c.verificado}T00:00:00`).toLocaleDateString('ca-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<div class="bg-brand-gray border border-brand-border rounded-xl p-5 flex flex-col gap-3">
  <h3 class="font-bold text-white leading-snug">{c.nombre}</h3>
  <div class="flex flex-wrap gap-1.5">
    {c.disciplinas.map(s => (
      <span class="bg-brand-dark border border-brand-border rounded-full px-2.5 py-0.5 text-xs text-brand-muted">{DISCIPLINES_CA[s] ?? s}</span>
    ))}
  </div>
  {c.otras && c.otras.length > 0 && <p class="text-xs text-brand-muted">També: {c.otras.join(', ')}</p>}
  {c.direccion && <p class="text-sm text-brand-muted">{c.direccion}</p>}
  <p class="text-xs text-brand-muted mt-auto">
    Font: <a href={c.fuente} rel="noopener" target="_blank" class="underline hover:text-white">{FUENTE_LABELS_CA[c.fuenteTipo]}</a> · verificat el {data}
  </p>
  {c.web && c.web !== c.fuente && (
    <a href={c.web} rel="noopener" target="_blank" class="text-sm text-brand-red hover:text-red-400">Web del centre →</a>
  )}
</div>
