---
// Comparativa entre disciplinas.
//
// Cuidado al tocar esto: la tabla completa (las diez disciplinas) solo puede
// vivir en UNA página. Se probó a ponerla en los diez hubs de disciplina y el
// solapamiento entre hubs subió del 47 % al 53 % — cambiar una duplicación por
// otra. Ahora la tabla completa es de `/iniciacion/`, que es exactamente la
// página de "no sé cuál elegir", y cada hub muestra solo sus tres alternativas
// naturales, que son distintas en cada uno.
import { PERFIL_COMPARATIVO, type Discipline } from '../data/disciplines';

interface Props {
  /** Disciplinas a mostrar, en orden */
  disciplinas: Discipline[];
  /** Slug de la disciplina que se resalta como "estás aquí" */
  actual?: string;
}
const { disciplinas, actual } = Astro.props;
const filas = disciplinas
  .map(d => ({ d, perfil: PERFIL_COMPARATIVO[d.slug] }))
  .filter(x => x.perfil);
---

<div class="overflow-x-auto -mx-4 px-4">
  <table class="w-full text-sm border-collapse min-w-[46rem]">
    <thead>
      <tr class="bg-brand-gray">
        <th class="text-left font-bold text-white p-3 border border-brand-border">Disciplina</th>
        <th class="text-left font-bold text-white p-3 border border-brand-border">Qué se hace</th>
        <th class="text-left font-bold text-white p-3 border border-brand-border">Contacto al empezar</th>
        <th class="text-left font-bold text-white p-3 border border-brand-border">Desde qué edad</th>
        <th class="text-left font-bold text-white p-3 border border-brand-border">Primera compra</th>
        <th class="text-left font-bold text-white p-3 border border-brand-border">Competición</th>
      </tr>
    </thead>
    <tbody>
      {filas.map(({ d, perfil }) => (
        <tr class:list={[d.slug === actual ? 'bg-brand-red/10' : 'odd:bg-brand-dark/40']}>
          <th scope="row" class="text-left p-3 border border-brand-border font-semibold whitespace-nowrap">
            {d.slug === actual ? (
              <span class="text-brand-red">{d.nameEs} · esta guía</span>
            ) : (
              <a href={`/${d.slug}/`} class="text-white hover:text-brand-red transition-colors">{d.nameEs}</a>
            )}
          </th>
          <td class="p-3 border border-brand-border text-brand-muted">{perfil.enfoque}</td>
          <td class="p-3 border border-brand-border text-brand-muted">{perfil.contacto}</td>
          <td class="p-3 border border-brand-border text-brand-muted">{perfil.edad}</td>
          <td class="p-3 border border-brand-border text-brand-muted">{perfil.equipacion}</td>
          <td class="p-3 border border-brand-border text-brand-muted">{perfil.competicion}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
