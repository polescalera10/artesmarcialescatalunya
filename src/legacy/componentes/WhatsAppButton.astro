---
import { whatsappActivo, whatsappLink } from '../data/site';

// Botón de WhatsApp. Se pinta solo si hay número configurado en site.ts, así
// que el componente se puede colocar en cualquier plantilla desde ya y no
// aparece nada hasta que Pol dé el número.
//
// El mensaje va prerrellenado con disciplina y municipio cuando la página los
// conoce: el lead llega calificado desde el primer mensaje, que es lo que un
// centro comprador quiere recibir.
interface Props {
  disciplina?: string;
  municipio?: string;
  variante?: 'primario' | 'secundario' | 'texto';
  class?: string;
}
const { disciplina, municipio, variante = 'secundario', class: extraClass = '' } = Astro.props;

const contexto = disciplina && municipio
  ? `${disciplina.toLowerCase()} en ${municipio}`
  : disciplina
    ? disciplina.toLowerCase()
    : municipio
      ? `artes marciales en ${municipio}`
      : 'artes marciales en el Garraf';

const mensaje = `Hola, os escribo desde la guía de Artes Marciales Garraf. Me interesa ${contexto} y me gustaría que me orientarais sobre por dónde empezar.`;

const CLASES = {
  primario: 'bg-brand-red hover:bg-red-700 text-white font-bold px-8 py-3 rounded-lg',
  secundario:
    'bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-3 rounded-lg border border-white/20',
  texto: 'text-brand-red hover:text-red-400 font-semibold',
};
---

{whatsappActivo && (
  <a
    href={whatsappLink(mensaje)}
    target="_blank"
    rel="noopener"
    class:list={[
      'inline-flex items-center justify-center gap-2 transition-colors',
      CLASES[variante],
      extraClass,
    ]}
  >
    <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z" />
      <path d="M12.04 2.5c-5.25 0-9.52 4.27-9.52 9.52 0 1.68.44 3.32 1.28 4.77L2.5 21.5l4.85-1.27a9.5 9.5 0 0 0 4.69 1.23h.01c5.25 0 9.52-4.27 9.52-9.52 0-2.54-.99-4.93-2.79-6.73a9.45 9.45 0 0 0-6.74-2.71zm0 17.42h-.01a7.9 7.9 0 0 1-4.02-1.1l-.29-.17-2.99.78.8-2.92-.19-.3a7.88 7.88 0 0 1-1.21-4.19c0-4.36 3.55-7.91 7.92-7.91a7.86 7.86 0 0 1 5.59 2.32 7.86 7.86 0 0 1 2.32 5.6c0 4.36-3.55 7.9-7.92 7.9z" />
    </svg>
    WhatsApp
  </a>
)}
